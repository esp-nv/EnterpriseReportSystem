@model string

@{
    string displayUsername = Model;
}

<div class="dropdown text-end">
    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle px-3 py-1 rounded-2 border shadow-sm"
       id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false"
       style="background-color: var(--bs-card-bg) !important; color: var(--bs-body-color) !important; border-color: var(--bs-border-color) !important;">
        <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold me-2 shadow-sm" style="width: 32px; height: 32px; font-size: 0.85rem;">
            @(displayUsername.Substring(0, Math.Min(2, displayUsername.Length)).ToUpper())
        </div>
        <span class="fw-bold small">@displayUsername</span>
    </a>

    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow border-secondary mt-2 fs-7" aria-labelledby="userDropdown" style="min-width: 240px;">
        <li>
            <a class="dropdown-item py-2 d-flex align-items-center" href="#">
                <i class="bi bi-people me-2 text-secondary"></i> Превключи на друг user
            </a>
        </li>
        <li><hr class="dropdown-divider border-secondary"></li>
        <li class="dropdown-header text-uppercase fw-bold pb-1 text-muted" style="font-size: 0.65rem;">
            <i class="bi bi-grid-1x2 me-1"></i> Вид меню
        </li>
        <li class="px-3 pb-2">
            <span class="badge bg-secondary text-white w-100 py-1 text-uppercase border border-secondary">@ViewData["GlobalLayout"]</span>
        </li>
        <li class="dropdown-header text-uppercase fw-bold pb-1 text-muted" style="font-size: 0.65rem;">
            <i class="bi bi-palette me-1"></i> Тема
        </li>
        <li class="px-3 pb-2">
            <span class="badge bg-warning text-dark w-100 py-1 text-uppercase fw-bold">@ViewData["GlobalTheme"]</span>
        </li>
        <li><hr class="dropdown-divider border-secondary"></li>
        <li>
            <a class="dropdown-item py-2 d-flex align-items-center fw-bold text-warning" href="/User/Settings">
                <i class="bi bi-gear-fill me-2"></i> Настройки
            </a>
        </li>
        <li><hr class="dropdown-divider border-secondary"></li>
        <li>
            <span class="dropdown-item py-2 d-flex align-items-center text-danger fw-bold text-opacity-50" style="cursor: not-allowed; opacity: 0.5;">
                <i class="bi bi-box-arrow-right me-2"></i> Изход
            </span>
        </li>
    </ul>
</div>
