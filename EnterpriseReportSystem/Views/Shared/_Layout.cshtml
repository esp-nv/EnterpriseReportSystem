@{
    // Прочитаме глобалните параметри, налети директно от _ViewStart
    string themeFile = ViewData["GlobalTheme"]?.ToString() ?? "dark";
    string layoutStyle = ViewData["GlobalLayout"]?.ToString() ?? "RIBBON";
    bool isCustomActive = Convert.ToBoolean(ViewData["IsCustomPaletteActive"]);

    // Зареждаме класовете от релационната ни таблица
    string navbarClass = ViewData["NavbarClass"]?.ToString() ?? "text-bg-dark";
    string sidebarClass = ViewData["SidebarClass"]?.ToString() ?? "bg-dark";
    string textClass = ViewData["TextClass"]?.ToString() ?? "text-white";
    string badgeClass = ViewData["BadgeClass"]?.ToString() ?? "text-bg-warning";
    string activeMenuClass = ViewData["ActiveMenuClass"]?.ToString() ?? "text-warning";

    string displayUsername = "admin_holding";
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Холдинг ERP</title>

    <!-- ТВОЯТА ВЪЛШЕБНА АРХИТЕКТУРНА ПРОВЕРКА ЗА ИЗКЛЮЧВАНЕ НА BOOTSTRAP -->
    @if (!isCustomActive)
    {
        <!-- СТЪЛБ 1 & 2: ЧИСТ БУТСТРАП (Зарежда основния рамков фреймуърк) -->
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    else
    {
        <!-- СТЪЛБ 3 & 4: ПОТРЕБИТЕЛСКИ НАСТРОЙКИ (Твоите два матрични CSS модула) -->
        <link rel="stylesheet" href="~/css/themes/user_variables.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/themes/user_themes.css" asp-append-version="true" />
    }

    <!-- Фиксиран линк за иконите на Bootstrap и базовия стил на проекта -->
    <!-- ПОПРАВКА: Вкарваме истинския работещ адрес за иконите на Bootstrap -->
    <link rel="stylesheet" href="https://jsdelivr.net">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<!-- Вграждаме динамичния контрастен атрибут на Bootstrap 5.3 директно в тялото -->
<body data-bs-theme="@themeFile">

    @if (layoutStyle == "DASHBOARD")
    {
        <!-- ========================================================================= -->
        <!-- МАКЕТ А: ВЕРТИКАЛЕН СТРАНИЧЕН DASHBOARD ИНТЕРФЕЙС (CRYPTO WALLET СТИЛ)    -->
        <!-- ========================================================================= -->
        <div class="wrapper">
            <nav class="sidebar @(isCustomActive ? "user-sidebar-custom" : sidebarClass)" style="min-width: 260px; max-width: 260px;">
                <div class="sidebar-header">
                    <a href="/" class="logo-link text-decoration-none fw-bold text-warning fs-5">
                        <i class="bi bi-building-fill me-2"></i> ХОЛДИНГ ERP
                    </a>
                </div>
                <ul class="list-unstyled components">
                    <li>
                        <a href="/Report/Index" class="@(Context.Request.Path.Value == "/Report/Index" || Context.Request.Path.Value == "/Report" ? "active-page " + activeMenuClass : "")">
                            <i class="bi bi-speedometer2 me-2 user-icon-accent"></i> Оперативен Панел
                        </a>
                    </li>
                    <li>
                        <a href="/Setup/CreateAsset" class="@(Context.Request.Path.Value == "/Setup/CreateAsset" ? "active-page " + activeMenuClass : "")">
                            <i class="bi bi-box-seam me-2 user-icon-accent"></i> Нов Актив
                        </a>
                    </li>
                    <li>
                        <a href="/User/Settings" class="@(Context.Request.Path.Value == "/User/Settings" ? "active-page " + activeMenuClass : "")">
                            <i class="bi bi-gear-fill me-2 user-icon-accent"></i> Настройки
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="content-area">
                <!-- Горна бърза контролна лента на Dashboard-а -->
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between mx-3 mt-2 rounded-3 shadow-sm" style="background-color: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.05) !important;">
                    <span class="fw-bold text-muted small text-uppercase"><i class="bi bi-layers-half me-1"></i> Контролен център</span>
                    @Html.Partial("_UserProfileDropdown", displayUsername)
                </div>
                <div class="p-4">
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ========================================================================= -->
        <!-- МАКЕТ Б: ХОРИЗОНТАЛЕН КЛАСИЧЕСКИ RIBBON UI ИНТЕРФЕЙС (ГОРНА ЛЕНТА)         -->
        <!-- ========================================================================= -->
        <header class="p-3 shadow-sm @(isCustomActive ? "user-navbar-custom" : navbarClass) border-bottom" style="border-color: rgba(255,255,255,0.08) !important;">
            <div class="container-fluid px-4">
                <div class="d-flex align-items-center justify-content-between">

                    <div class="d-flex align-items-center gap-4">
                        <a href="/" class="logo-link d-flex align-items-center text-decoration-none fw-bold fs-5 tracking-wider text-warning">
                            <i class="bi bi-building-fill me-2"></i> ХОЛДИНГ ERP
                        </a>
                        <ul class="nav d-flex align-items-center gap-2 mb-0 fs-7">
                            <li>
                                <a href="/Report/Index" class="nav-link px-3 fw-bold text-uppercase @(Context.Request.Path.Value == "/Report/Index" || Context.Request.Path.Value == "/Report" ? "active-page" : "")" style="color: @(isCustomActive ? "var(--custom-navbar-text)" : "inherit") !important;">
                                    Оперативен Панел
                                </a>
                            </li>
                            <li>
                                <a href="/Setup/CreateAsset" class="nav-link px-3 fw-bold text-uppercase @(Context.Request.Path.Value == "/Setup/CreateAsset" ? "active-page" : "")" style="color: @(isCustomActive ? "var(--custom-navbar-text)" : "inherit") !important;">
                                    Нов Актив
                                </a>
                            </li>
                        </ul>
                    </div>

                    @Html.Partial("_UserProfileDropdown", displayUsername)

                </div>
            </div>
        </header>

        <div class="container-fluid px-4 py-4">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
