@inject EnterpriseReportSystem.Data.ApplicationDbContext _context

@{
    // Извличаме потребителя с Id = 1 директно от базата данни
    var currentUser = _context.SystemUsers.FirstOrDefault(u => u.Id == 1);

    // Първични защити против null стойности
    string displayUsername = currentUser != null ? currentUser.Username : "Гост";
    string displayLayout = currentUser != null ? currentUser.LayoutType : "WORD";
    string displayTheme = currentUser != null ? currentUser.ThemeType : "LIGHT";
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnterpriseReportSystem</title>

    <!-- Базови Bootstrap 5 Стилизации -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Интегриране на Bootstrap Icons за иконите в менюто -->
    <link rel="stylesheet" href="https://jsdelivr.net">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnterpriseReportSystem.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- ОФИЦИАЛЕН ТЪМЕН БУТСТРАП ХЕДЪР -->
    <header class="p-3 bg-dark text-white border-bottom border-secondary">
        <div class="container-fluid px-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between">

                <!-- ЛЯВА ЧАСТ: ЛОГО И ГЛАВНИ ВРЪЗКИ -->
                <div class="d-flex align-items-center gap-4">
                    <!-- КОРЕКЦИЯ: Логото вече пренасочва строго към празната Home страница (/) -->
                    <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 text-white text-decoration-none fw-bold fs-5 tracking-wider text-warning">
                        <i class="bi bi-building-fill me-2"></i> ХОЛДИНГ ERP
                    </a>

                    <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0 fs-7">
                        <li><a href="/Report/Index" class="nav-link px-3 text-secondary fw-bold text-uppercase">Оперативен Панел</a></li>
                        <li><a href="/Setup/CreateAsset" class="nav-link px-3 text-white fw-bold text-uppercase">Нов Актив</a></li>
                    </ul>
                </div>

                <!-- ДЯСНА ЧАСТ: КРЪГЪЛ АВАТАР И ПАДАЩО МЕНЮ НА НАШИЯ USER -->
                <div class="dropdown text-end">
                    <a href="#" class="d-flex align-items-center link-light text-decoration-none dropdown-toggle px-2 py-1 rounded-2 border border-secondary bg-secondary-subtle"
                       id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <!-- Кръгла икона за потребител спрямо примера на Bootstrap -->
                        <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold me-2 shadow-sm" style="width: 32px; height: 32px; font-size: 0.85rem;">
                            @(displayUsername.Substring(0, Math.Min(2, displayUsername.Length)).ToUpper())
                        </div>
                        <span class="fw-bold small text-white">@displayUsername</span>
                    </a>

                    <!-- ТВОИТЕ СТРОГО ПОДРЕДЕНИ 8 СЕКЦИИ НА МЕНЮТО -->
                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow border-secondary mt-2 fs-7" aria-labelledby="userDropdown" style="min-width: 240px;">

                        <!-- 1. Превключи на друг потребител -->
                        <li>
                            <a class="dropdown-item py-2 d-flex align-items-center" href="#">
                                <i class="bi bi-people me-2 text-secondary"></i> Превключи на друг user
                            </a>
                        </li>

                        <!-- 2. Разделител -->
                        <li><hr class="dropdown-divider border-secondary"></li>

                        <!-- 3. Вид меню -->
                        <li class="dropdown-header text-uppercase fw-bold pb-1 text-muted" style="font-size: 0.65rem;">
                            <i class="bi bi-grid-1x2 me-1"></i> Вид меню
                        </li>
                        <li class="px-3 pb-2">
                            <span class="badge bg-secondary text-white w-100 py-1 text-uppercase border border-secondary">@displayLayout</span>
                        </li>

                        <!-- 4. Тема -->
                        <li class="dropdown-header text-uppercase fw-bold pb-1 text-muted" style="font-size: 0.65rem;">
                            <i class="bi bi-palette me-1"></i> Тема
                        </li>
                        <li class="px-3 pb-2">
                            <span class="badge bg-warning text-dark w-100 py-1 text-uppercase fw-bold">@displayTheme</span>
                        </li>

                        <!-- 5. Разделител -->
                        <li><hr class="dropdown-divider border-secondary"></li>

                        <!-- 6. Настройки -->
                        <li>
                            <a class="dropdown-item py-2 d-flex align-items-center fw-bold text-warning" href="/User/Settings">
                                <i class="bi bi-gear-fill me-2"></i> Настройки
                            </a>
                        </li>

                        <!-- 7. Разделител -->
                        <li><hr class="dropdown-divider border-secondary"></li>

                        <!-- 8. Изход без линкове -->
                        <li>
                            <span class="dropdown-item py-2 d-flex align-items-center text-danger fw-bold text-opacity-50" style="cursor: not-allowed; opacity: 0.5;">
                                <i class="bi bi-box-arrow-right me-2"></i> Изход
                            </span>
                        </li>

                    </ul>
                </div>

            </div>
        </div>
    </header>

    <!-- ОСНОВНО СЪДЪРЖАНИЕ НА СТРАНИЦИТЕ -->
    <div class="container-fluid px-4 py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
