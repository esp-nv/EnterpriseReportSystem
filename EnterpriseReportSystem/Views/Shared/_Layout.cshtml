@{
    // 1. Прочитаме глобалните параметри, налети директно от _ViewStart през LINQ
    string themeFile = ViewData["GlobalTheme"]?.ToString() ?? "dark";
    string layoutStyle = ViewData["GlobalLayout"]?.ToString() ?? "RIBBON";
    bool isCustomActive = Convert.ToBoolean(ViewData["IsCustomPaletteActive"]);
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ХОЛДИНГ ERP</title>

    <!-- 1. ИНТЕЛЕГЕНТНО ДИНАМИЧНО ЗАРЕЖДАНЕ НА ТЕМАТА ОТ ТВОЯТА ЛОКАЛНА ПАПКА -->
    @if (ViewData["IsCustomPaletteActive"] != null && (bool)ViewData["IsCustomPaletteActive"] == true && ViewData["CustomThemeFileName"] != null && !string.IsNullOrEmpty(ViewData["CustomThemeFileName"].ToString()))
    {
        <!-- Ако е активна локална тема, зареждаме директно нейния файл от твоята папка -->
        <link rel="stylesheet" href="~/css/themes/@ViewData["CustomThemeFileName"]" asp-append-version="true" />
    }
    else
    {
        <!-- Бекъп защита: Ако е на Фабричен Bootstrap, зареждаме стандартния основен стил -->
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }

    <link rel="stylesheet" href="https://jsdelivr.net" />

    <!-- 2. ГЛОБАЛНИ СТИЛОВЕ НА ХОЛДИНГА -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>



<body data-bs-theme="@themeFile" class="d-flex flex-column min-height-100vh">

    @if (layoutStyle == "DASHBOARD")
    {
        <!-- ========================================================================= -->
        <!-- МАКЕТ А: ВЕРТИКАЛЕН СТРАНИЧЕН DASHBOARD ИНТЕРФЕЙС                        -->
        <!-- ========================================================================= -->
        <div class="wrapper flex-grow-1">
            @Html.Partial("_Sidebar")

            <div class="content-area d-flex flex-column">
                <!-- Горна бърза контролна лента за Dashboard-а -->
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between mx-3 mt-2 rounded-3 shadow-sm" style="background-color: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.05) !important;">
                    <span class="fw-bold text-muted small text-uppercase"><i class="bi bi-layers-half me-1"></i> Контролен център</span>
                    @Html.Partial("_UserProfileDropdown", "admin_holding")
                </div>

                <div class="p-4 flex-grow-1">
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ========================================================================= -->
        <!-- МАКЕТ Б: ХОРИЗОНТАЛЕН КЛАСИЧЕСКИ RIBBON UI ИНТЕРФЕЙС                       -->
        <!-- ========================================================================= -->
        @Html.Partial("_Header")

        <div class="container-fluid px-4 py-4 flex-grow-1">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <!-- Споделен изолиран компонент за футера -->
    @Html.Partial("_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
