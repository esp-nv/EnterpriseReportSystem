@using EnterpriseReportSystem.Services.Interfaces
@model IEnumerable<ITrackableAsset>

<div class="container-fluid mt-4" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">📊 Количествена Оборотна Ведомост (ДПЖ / ЕПЖ / Склад)</h2>
        <span class="badge bg-secondary p-2">Реално време (SQL Server)</span>
    </div>

    <!-- КРИТЕРИИ И ФИЛТРИ -->
    <div class="card shadow-sm p-4 mb-4 bg-light">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold">Филтър по Обект / Локация</label>
                <select name="municipality" asp-items="ViewBag.Municipalities" class="form-select">
                    <option value="">-- Всички обекти --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Критерий: Група активи</label>
                <select name="groupCode" asp-items="ViewBag.Groups" class="form-select">
                    <option value="">-- Всички групи (ДПЖ/ЕПЖ) --</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100 btn-lg shadow-sm">Генерирай Справка</button>
            </div>
        </form>
    </div>

    <!-- СЧЕТОВОДНА ТАБЛИЦА -->
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow rounded-3">
            <table class="table table-bordered table-striped table-hover align-middle mb-0 bg-white">
                <thead class="table-dark text-center">
                    <tr>
                        <th rowspan="2" class="align-middle">Идентификатор (Марка/Баркод)</th>
                        <th rowspan="2" class="align-middle">Наименование на актива</th>
                        <th rowspan="2" class="align-middle">Тип</th>
                        <th rowspan="2" class="align-middle bg-primary text-white">Начално салдо (Бр.)</th>
                        <th colspan="2" class="bg-secondary text-white">Движение през периода</th>
                        <th rowspan="2" class="align-middle bg-success text-white">Краен баланс (Бр.)</th>
                    </tr>
                    <tr>
                        <th class="bg-light text-dark">Приход (+)</th>
                        <th class="bg-light text-dark">Разход (-)</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @foreach (var asset in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@asset.Id</td>
                            <td class="text-start">
                                <div class="fw-bold text-dark">@asset.Name</div>
                                <small class="text-muted">📍 @asset.Facility (@asset.TownOrVillage)</small>
                            </td>
                            <td>
                                <span class="badge @(asset.Group.IsAnimal ? "bg-success" : "bg-info text-dark")">
                                    @(asset.Group.IsAnimal ? "Животно" : "Стока")
                                </span>
                                <br />
                                <small class="text-secondary fw-bold">@asset.Group.Name</small>
                            </td>
                            <td class="fw-bold bg-light">@asset.InitialCount</td>
                            <td class="text-success fw-bold">+@asset.InputCount</td>
                            <td class="text-danger fw-bold">-@asset.OutputCount</td>
                            <td class="fw-bold table-success text-dark">@asset.FinalCount</td>
                        </tr>
                    }
                </tbody>
                <!-- АВТОМАТИЧЕН ОБОБЩЕН РЕД НАЙ-ОТДОЛУ -->
                <tfoot class="table-secondary fw-bold text-center align-middle">
                    <tr>
                        <td colspan="3" class="text-end text-uppercase">Общо за извадката:</td>
                        <td class="bg-light text-dark">@Model.Sum(x => x.InitialCount)</td>
                        <td class="text-success">+@Model.Sum(x => x.InputCount)</td>
                        <td class="text-danger">-@Model.Sum(x => x.OutputCount)</td>
                        <td class="table-success text-dark">@Model.Sum(x => x.FinalCount)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center shadow-sm p-4" role="alert">
            <h5 class="alert-heading fw-bold">📭 Системата е готова за работа</h5>
            <p class="mb-0 text-muted">Изберете критерии от горния панел и натиснете "Генерирай Справка", за да извлечете оборотната ведомост от SQL Server.</p>
        </div>
    }
</div>
