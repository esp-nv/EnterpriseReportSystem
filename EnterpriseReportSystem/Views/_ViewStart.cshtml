@inject EnterpriseReportSystem.Data.ApplicationDbContext _context
@using Microsoft.EntityFrameworkCore
@using EnterpriseReportSystem.Models.Entities.Structure
@using EnterpriseReportSystem.Common.Enum

@{
    // 1. Извличаме глобалните настройки на текущия потребител безопасно заедно с темата му
    var currentUser = _context.SystemUsers
        .Include(u => u.GlobalTheme)
        .AsNoTracking()
        .FirstOrDefault(u => u.Id == 1);

    // 2. ОПРЕДЕЛЯМЕ АКТИВНАТА ТЕМА И ОФОРМЛЕНИЕТО ЧРЕЗ ENUM ФЛАГОВЕТЕ
    bool isDark = currentUser != null ? currentUser.IsDarkUserPreference : true;

    // Преобразуваме числото от базата към текстова директива за шаблона
    string layoutStyle = "DASHBOARD";
    if (currentUser != null)
    {
        if (currentUser.LayoutType == AppLayoutType.Ribbon) layoutStyle = "RIBBON";
        else if (currentUser.LayoutType == AppLayoutType.Navbar) layoutStyle = "NAVBAR";
    }

    ViewData["GlobalTheme"] = isDark ? "dark" : "light";
    ViewData["GlobalLayout"] = layoutStyle;
    ViewData["IsCustomPaletteActive"] = currentUser != null ? currentUser.IsCustomPaletteActive : false;
    ViewData["CustomThemeFileName"] = currentUser?.GlobalTheme?.FileName ?? string.Empty;

    // 3. ИНТЕЛЕГЕНТНА КОНТРАСТНА ЗАЩИТА НА КЛАСОВЕТЕ СПРЯМО СВЕТЪЛ/ТЪМЕН РЕЖИМ
    if (!isDark)
    {
        // Ако потребителят е маркиран за СВЕТЪЛ режим (false)
        ViewData["NavbarClass"] = "navbar-light bg-light border-bottom";
        ViewData["SidebarClass"] = "bg-light border-end";
        ViewData["AccountingTableClass"] = "table-light table-striped";
        ViewData["CardStyleClass"] = "shadow-sm border";
        ViewData["FooterLayoutClass"] = "d-flex justify-content-between align-items-center text-dark bg-light";
        ViewData["TextClass"] = "text-dark";
        ViewData["ActiveMenuClass"] = "text-primary fw-bold";
    }
    else
    {
        // Ако е в ТЪМЕН режим (true) - Ако има качен външен CSS, той ще пренапише тези базови класове
        ViewData["NavbarClass"] = "navbar-dark bg-dark border-bottom border-secondary";
        ViewData["SidebarClass"] = "bg-dark border-end border-secondary";
        ViewData["AccountingTableClass"] = "table-dark table-striped";
        ViewData["CardStyleClass"] = "bg-secondary shadow";
        ViewData["FooterLayoutClass"] = "d-flex justify-content-between align-items-center text-white bg-dark border-top border-secondary";
        ViewData["TextClass"] = "text-white";
        ViewData["ActiveMenuClass"] = "text-warning fw-bold";
    }

    Layout = "_Layout";
}
