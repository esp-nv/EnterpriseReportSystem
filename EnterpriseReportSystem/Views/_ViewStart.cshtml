@inject EnterpriseReportSystem.Data.ApplicationDbContext _context
@using Microsoft.EntityFrameworkCore

@{
    // 1. Извличаме глобалните настройки на текущия потребител безопасно през Анонимен одит
    var currentUser = _context.SystemUsers.AsNoTracking().FirstOrDefault(u => u.Id == 1);

    // 2. ИЗВЛИЧАМЕ ВСИЧКИ НЕГОВИ СВОЙСТВА, ЗАЕДНО С НАИМЕНОВАНИЯТА НА ГЛАВНИТЕ ЗОНИ ПРЕЗ .INCLUDE()
    var userStyles = _context.SystemUserThemes
        .Include(t => t.SystemUIElement)
        .AsNoTracking()
        .Where(t => t.SystemUserId == 1)
        .ToList();

    // 3. ПРЕДАВАМЕ ГЛОБАЛНИТЕ ФЛАГОВЕ КЪМ LAYOUT-А ЧРЕЗ VIEWDATA
    ViewData["GlobalTheme"] = currentUser != null ? currentUser.ThemeType.Trim().ToLower() : "dark";
    ViewData["GlobalLayout"] = currentUser != null ? currentUser.LayoutType.Trim().ToUpper() : "RIBBON";
    ViewData["IsCustomPaletteActive"] = currentUser != null ? currentUser.IsCustomPaletteActive : false;

    // 4. ТВОЯТА СЪВЪРШЕНА WORDPRESS МАГИЯ: Сглобяваме на куп (с интервал) класовете за всяка зона!

    // Сглобява всички редове за Хедъра (напр. "bg-dark text-warning")
    ViewData["NavbarClass"] = string.Join(" ", userStyles
        .Where(s => s.SystemUIElement?.ElementKey == "HEADER_ZONE")
        .Select(s => s.BootstrapClass));

    // Сглобява всички редове за Сайдбара (напр. "bg-dark")
    ViewData["SidebarClass"] = string.Join(" ", userStyles
        .Where(s => s.SystemUIElement?.ElementKey == "SIDEBAR_ZONE")
        .Select(s => s.BootstrapClass));

    // Сглобява всички редове за Таблиците (напр. "table-dark table-striped")
    ViewData["AccountingTableClass"] = string.Join(" ", userStyles
        .Where(s => s.SystemUIElement?.ElementKey == "TABLE_ZONE")
        .Select(s => s.BootstrapClass));

    // Сглобява контурите, заоблянето и сенките за Картите
    ViewData["CardStyleClass"] = string.Join(" ", userStyles
        .Where(s => s.SystemUIElement?.ElementKey == "CARD_ZONE")
        .Select(s => s.BootstrapClass));

    // Сглобява подравняването и цветовете за Футера
    ViewData["FooterLayoutClass"] = string.Join(" ", userStyles
        .Where(s => s.SystemUIElement?.ElementKey == "FOOTER_ZONE")
        .Select(s => s.BootstrapClass));

    // Насочваме проекта към главния майсторски шаблон
    Layout = "_Layout";
}
