@model EnterpriseReportSystem.Models.Entities.Structure.SystemUser

@{
    ViewData["Title"] = "Потребителски настройки и Визуални теми";
}

<div class="container my-5" style="max-width: 800px;">
    <div class="card shadow-sm border border-light-subtle rounded-3">

        <!-- Хедър на Панела за Настройки -->
        <div class="card-header bg-dark text-white p-3 border-0 rounded-top-3 d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-bold fs-6 text-uppercase tracking-wider">
                <i class="bi bi-palette-fill text-warning me-2"></i> Персонална конфигурация на интерфейса
            </h5>
            <span class="badge bg-secondary">Потребител: @Model.Username</span>
        </div>

        <div class="card-body p-4 bg-light-subtle">

            @if (TempData["SettingsSuccess"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show fw-bold mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SettingsSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="SaveSettings" asp-controller="User" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <!-- Скрит идентификатор за сигурен запис -->
                <input type="hidden" asp-for="Id" />

                <!-- СЕКЦИЯ 1: СТИЛ НА НАВИГАЦИЯТА (Layout Type) -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 p-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2 text-uppercase fs-7 text-secondary">
                        <i class="bi bi-grid-1x2 text-primary me-2"></i> 1. Архитектура на Главното Меню
                    </h6>
                    <div class="row g-3 align-items-center">
                        <div class="col-md-7">
                            <label asp-for="LayoutType" class="form-label small fw-bold text-muted">Избор на тип меню</label>
                            <select asp-for="LayoutType" class="form-select form-select-sm rounded-2" required>
                                <option value="WORD">Лента с инструменти тип Microsoft WORD (Хоризонтална)</option>
                                <option value="DASHBOARD">Страничен контролен панел тип DASHBOARD (Вертикален)</option>
                                <option value="EXCEL">Компактна решетъчна матрица тип EXCEL</option>
                            </select>
                        </div>

                        <div class="col-md-5 pt-4 ps-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsMenuExpanded" id="menuExpandCheck">
                                <label class="form-check-label small fw-bold text-muted ms-2" for="menuExpandCheck">Разгънат режим по подразбиране</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- СЕКЦИЯ 2: КОРПОРАТИВНИ СЧЕТОВОДНИ ТЕМИ -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 p-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2 text-uppercase fs-7 text-secondary">
                        <i class="bi bi-brush text-success me-2"></i> 2. Визуална екрана тема (Themes)
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="ThemeType" class="form-label small fw-bold text-muted">Изберете софтуерна тема</label>
                            <select asp-for="ThemeType" class="form-select form-select-sm rounded-2" required>
                                <option value="LIGHT">Класическа Светла Офис Тема (Light Web)</option>
                                <option value="DARK">Тъмна Тема тип Microsoft Visual Studio (Dark Studio)</option>
                                <option value="PHOTOSHOP">Луксозна Тъмна Тема тип Adobe Photoshop (Оранжев Акцент)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- СЕКЦИЯ 3: ИНТЕЛИГЕНТНИ ПАЛИТРИ ЗА ПОТРЕБИТЕЛСКИ ЦВЕТОВЕ (ДИНАМИЧЕН ИЗБОР) -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 p-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2 text-uppercase fs-7 text-secondary">
                        <i class="bi bi-sliders text-danger me-2"></i> 3. Динамична потребителска палитра (Color Pickers)
                    </h6>
                    <p class="small text-muted mb-3">Ако желаете да пренастроите цветовете извън темите по подразбиране, изберете лични кодове от палитрите по-долу:</p>

                    <div class="row text-center g-3">
                        <div class="col-4">
                            <label class="form-label small fw-bold text-muted d-block">Цвят на фона</label>
                            <input type="color" class="form-control form-control-color mx-auto rounded-circle p-0 border-0 shadow-sm" id="bgColorPicker" value="#141414" title="Изберете основен цвят за екрана" style="width: 45px; height: 45px;">
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold text-muted d-block">Цвят на акцента</label>
                            <input type="color" class="form-control form-control-color mx-auto rounded-circle p-0 border-0 shadow-sm" id="accentColorPicker" value="#ff5500" title="Изберете цвят за активните бутони" style="width: 45px; height: 45px;">
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold text-muted d-block">Цвят на текста</label>
                            <input type="color" class="form-control form-control-color mx-auto rounded-circle p-0 border-0 shadow-sm" id="textColorPicker" value="#e0e0e0" title="Изберете цвят на буквите" style="width: 45px; height: 45px;">
                        </div>
                    </div>
                </div>

                <!-- БУТОН ЗА ЗАПИС -->
                <div class="mt-4 pt-2 text-end">
                    <button type="submit" class="btn btn-dark btn-md px-5 fw-bold rounded-2 shadow-sm">
                        <i class="bi bi-cloud-check-fill text-warning me-2"></i> Запази интерфейсните настройки
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    // Автоматична респонсив Bootstrap 5 валидация на формата при изпращане
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
    })()
</script>

<style>
    .fs-7 {
        font-size: 0.85rem;
    }
</style>
