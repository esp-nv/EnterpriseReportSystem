@model EnterpriseReportSystem.ViewModels.SettingsViewModel
@using EnterpriseReportSystem.Models.Entities.Structure
@using EnterpriseReportSystem.Common.Enum

@{
    ViewData["Title"] = "Потребителски настроки и Визуални теми";
}

<div class="container-fluid py-4 @ViewData["TextClass"]">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-light mb-1">Потребителски настройки и Визуални теми</h4>
            <small class="text-muted font-monospace">Управление на уеб параметрите.</small>
        </div>
    </div>

    <form asp-action="SaveSettings" asp-controller="User" method="post" class="row g-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Username" />
        <input type="hidden" asp-for="CompanyId" />

        <!-- ЛЯВ ПАНЕЛ: НАВИГАЦИОННИ ТАБОВЕ -->
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <div class="nav flex-column nav-pills" id="vs-tab-system" role="tablist">
                    <!-- БУТОН 1: ИДЕНТИЧНОСТ -->
                    <button class="nav-link active text-start mb-2" id="tab-profile-btn" data-bs-toggle="pill" data-bs-target="#content-profile" type="button" role="tab" aria-controls="content-profile" aria-selected="true">
                        <i class="bi bi-person-fill me-2"></i> Потребителски профил
                    </button>

                    <!-- БУТОН 2: СИСТЕМНИ ЕЛЕМЕНТИ -->
                    <button class="nav-link text-start mb-2" id="tab-elements-btn" data-bs-toggle="pill" data-bs-target="#content-elements" type="button" role="tab" aria-controls="content-elements" aria-selected="false">
                        <i class="bi bi-sliders me-2"></i> Системни елементи
                    </button>

                    <!-- БУТОН 3: НОВИЯТ ТАБ ЗА СИГУРНОСТ -->
                    <button class="nav-link text-start" id="tab-security-btn" data-bs-toggle="pill" data-bs-target="#content-security" type="button" role="tab" aria-controls="content-security" aria-selected="false">
                        <i class="bi bi-shield-lock-fill me-2 text-danger"></i> Сигурност на акаунта
                    </button>
                </div>


                <hr />
                <!-- БУТОН ЗА ОКОНЧАТЕЛНО СТАРТИРАНЕ НА ДИАЛОГА -->
                <button type="button" class="btn btn-primary w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#confirmSettingsModal">
                    <i class="bi bi-shield-check me-2"></i> Запечатай настройките
                </button>
            </div>
        </div>

        <!-- ДЕСЕН ПАНЕЛ: ДИНАМИЧНО СЪДЪРЖАНИЕ -->
        <div class="col-md-9">
            <div class="tab-content" id="vs-tab-content">

                <!-- ПАНЕЛ 1: ПОТРЕБИТЕЛСКИ ПРОФИЛ -->
                <div class="tab-pane fade show active" id="content-profile" role="tabpanel" aria-labelledby="tab-profile-btn">
                    <!-- КАРТА 1: ОБЩИ ДАННИ НА ОПЕРАТОРА -->
                    <div class="card p-4 mb-4 shadow-sm border-0 bg-body">
                        <h6 class="text-secondary text-uppercase tracking-wider small fw-bold mb-4 pb-2 border-bottom">
                            <i class="bi bi-person-badge text-primary me-2"></i> Идентификация на оператора
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold mb-1">Потребителско име (Отключено за промяна)</label>
                                <input type="text" asp-for="Username" class="form-control form-control-sm font-monospace border-secondary-subtle" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold mb-1">Глобален Администраторски Статус</label>
                                <div class="form-check form-switch mt-1">
                                    <input type="checkbox" asp-for="IsGlobalAdmin" class="form-check-input" disabled style="cursor: not-allowed;" />
                                    <label class="form-check-label small fw-bold text-danger" for="IsGlobalAdmin">Глобален контрол (Заключено)</label>
                                </div>
                                <input type="hidden" asp-for="IsGlobalAdmin" />
                            </div>
                        </div>
                    </div>
                    <!-- КАРТА 2: МАТРИЦА НА ПРАВАТА (ТИП ТАБЛИЦА С CRUD СИГУРНОСТ) -->
                    <div class="card p-4 shadow-sm border-0 bg-body">
                        <h6 class="text-secondary text-uppercase tracking-wider small fw-bold mb-3 pb-2 border-bottom">
                            <i class="bi bi-shield-shaded text-success me-2"></i> Системна матрица на корпоративните права
                        </h6>
                        <div class="table-responsive">
                            <table class="table align-middle font-monospace small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50%;">Системна роля на акаунта</th>
                                        <th style="width: 50%;">Прикачен Субект / Компания в холдинга</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            @if (Model.IsGlobalAdmin)
                                            {
                                                <!-- CRUD режим за Администратор: Активен избор -->
                                                <select asp-for="LayoutType" class="form-select form-select-sm border-success-subtle">
                                                    <option value="1">Глобален Dashboard Контролер</option>
                                                    <option value="2">Оперативен Мениджър (Ribbon)</option>
                                                    <option value="3">Системен Анализатор (Navbar)</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <!-- За обикновен оператор: Само за четене -->
                                                <input type="text" class="form-control form-control-sm bg-light border-secondary-subtle" value="Стандартен Системен Оператор" disabled style="cursor: not-allowed;" />
                                                <input type="hidden" asp-for="LayoutType" />
                                            }
                                        </td>
                                        <td>
                                            @if (Model.IsGlobalAdmin)
                                            {
                                                <!-- CRUD режим за Администратор: Смяна на Компания -->
                                                <select asp-for="CompanyId" class="form-select form-select-sm border-success-subtle">
                                                    <option value="1">Централен Холдинг АД</option>
                                                    <option value="2">Дъщерно Предприятие ЕООД</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <!-- За обикновен оператор: Само за четене -->
                                                <input type="text" class="form-control form-control-sm bg-light border-secondary-subtle" value="Централен Холдинг АД" disabled style="cursor: not-allowed;" />
                                                <input type="hidden" asp-for="CompanyId" />
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>



                <!-- ПАНЕЛ 2: СИСТЕМНИ ВИЗУАЛНИ ЕЛЕМЕНТИ -->
                <div class="tab-pane fade" id="content-elements" role="tabpanel">
                    <!-- 1. ГЛОБАЛНИ ПАРАМЕТРИ -->
                    <div class="card p-4 mb-4 shadow-sm">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">
                            <i class="bi bi-gear-fill text-warning me-2"></i> Глобални параметри (Общи настройки)
                        </h5>
                        <div class="row g-3 align-items-end">
                            <div class="col-md-8">
                                <label class="form-label fw-bold small">Вид на главното меню</label>
                                <select name="LayoutType" id="layoutSelector" class="form-select form-select-sm font-monospace">
                                    <option value="1" selected="@(Model.LayoutType == AppLayoutType.Dashboard ? "selected" : null)">Вертикален страничен контролен панел</option>
                                    <option value="2" selected="@(Model.LayoutType == AppLayoutType.Ribbon ? "selected" : null)">Хоризонтална лента тип MS Excel / Word (Ribbon)</option>
                                    <option value="3" selected="@(Model.LayoutType == AppLayoutType.Navbar ? "selected" : null)">Хоризонтална лента тип NAVBAR</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" name="IsMenuExpanded" id="isMenuExpandedSwitch" value="true" checked="@(Model.IsMenuExpanded ? "checked" : null)" style="cursor: pointer;" />
                                    <input type="hidden" name="IsMenuExpanded" value="false" />
                                    <label class="form-check-label small fw-bold" for="isMenuExpandedSwitch">
                                        <i class="bi bi-layout-sidebar-inset me-1"></i> Разпънато главно меню
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. НОВИЯТ ДВУКОЛОНЕН КОНФИГУРАТОР НА СТИЛОВЕ -->
                    <div class="card p-4 mb-4 shadow-sm">
                        <h5 class="fw-bold mb-4 border-bottom pb-2">
                            <i class="bi bi-palette-fill text-info me-2"></i> Конфигуратор на визуални стилове
                        </h5>
                        <div class="row g-4">
                            <!-- КОЛОНА 1: КОНТРАСТ НА ОКОЛНАТА СРЕДА -->
                            <div class="col-md-5 border-end pe-md-4">
                                <label class="form-label fw-bold small text-muted mb-3">
                                    <i class="bi bi-circle-half me-1"></i> 1. Контраст на околната среда (Глобален режим)
                                </label>
                                <div class="form-check mb-3">
                                    <input class="form-check-input mode-contrast-radio" type="radio" name="IsDarkUserPreference" id="modeDarkRadio" value="true" checked="@(Model.IsDarkUserPreference ? "checked" : null)" style="cursor: pointer;" />
                                    <label class="form-check-label fw-bold" for="modeDarkRadio">🌙 Тъмен конзолен профил</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input mode-contrast-radio" type="radio" name="IsDarkUserPreference" id="modeLightRadio" value="false" checked="@(!Model.IsDarkUserPreference ? "checked" : null)" style="cursor: pointer;" />
                                    <label class="form-check-label" for="modeLightRadio">☀️ Светъл уеб режим</label>
                                </div>
                            </div>
                            <!-- КОЛОНА 2: ПРОИЗХОД И ИЗБОР НА СТИЛ -->
                            <div class="col-md-7 ps-md-4">
                                <label class="form-label fw-bold small text-muted mb-3">
                                    <i class="bi bi-code-square me-1"></i> 2. Произход и избор на стиловия слой
                                </label>
                                <div class="form-check p-0 mb-3 d-flex align-items-center" style="height: 31px;">
                                    <input class="form-check-input theme-source-radio ms-0 me-2" type="radio" name="IsCustomPaletteActive" id="radioFactoryStyle" value="false" checked="@(!Model.IsCustomPaletteActive ? "checked" : null)" style="cursor: pointer;" />
                                    <label class="form-check-label" for="radioFactoryStyle">
                                        <i class="bi bi-cpu me-1 text-secondary"></i> Фабричен Bootstrap изглед
                                    </label>
                                </div>
                                <div class="input-group input-group-sm">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text font-monospace">
                                            <input class="theme-source-radio mt-0 me-2" type="radio" name="IsCustomPaletteActive" id="radioCustomStyle" value="true" checked="@(Model.IsCustomPaletteActive ? "checked" : null)" style="cursor: pointer;" />
                                            <label class="m-0 small fw-bold" for="radioCustomStyle" style="cursor: pointer;">
                                                <i class="bi bi-file-earmark-code text-success me-1"></i> Персонализирана тема:
                                            </label>
                                        </div>
                                    </div>
                                    <select name="ThemeId" id="themeIdDropdown" class="form-control font-monospace form-select">
                                        @if (Model.AvailableThemes != null)
                                        {
                                            foreach (var theme in Model.AvailableThemes)
                                            {
                                                string square = theme.SupportType ? "⬛" : "⬜";
                                                string isDarkTheme = theme.SupportType.ToString().ToLower();
                                                if (Model.ThemeId == theme.Id)
                                                {
                                                    <option value="@theme.Id" data-file="@theme.FileName" data-dark="@isDarkTheme" selected="selected">✓ @square @theme.ThemeName</option>
                                                }
                                                else
                                                {
                                                    <option value="@theme.Id" data-file="@theme.FileName" data-dark="@isDarkTheme">@square @theme.ThemeName</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ПАНЕЛ 3: СИГУРНОСТ НА АКАУНТА -->
                <div class="tab-pane fade" id="content-security" role="tabpanel" aria-labelledby="tab-security-btn">
                    <div class="card p-4 shadow-sm border-0 bg-body">
                        <!-- ФИКСИРАН ЕТИКЕТ ЗА ТЕКУЩИЯ ПОТРЕБИТЕЛ -->
                        <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                            <h6 class="text-secondary text-uppercase tracking-wider small fw-bold m-0">
                                <i class="bi bi-shield-lock-fill text-danger me-2"></i> Управление на паролите и сигурността
                            </h6>
                            <span class="badge bg-secondary-subtle text-secondary font-monospace border border-secondary-subtle px-3 py-2 small fw-bold">
                                <i class="bi bi-person-circle me-1 text-primary"></i> Сигурност за акаунт: @Model.Username
                            </span>
                        </div>
                        <div class="row g-3">
                            <!-- 1. ТЕКУЩА ПАРОЛА -->
                            <div class="col-12">
                                <label class="form-label text-muted small fw-bold mb-1">Текуща системна парола</label>
                                <input type="password" asp-for="CurrentPassword" id="inputCurrentPass" class="form-control form-control-sm font-monospace border-secondary-subtle" autocomplete="off" />
                                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                            </div>
                            <!-- 2. НОВА ПАРОЛА -->
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold mb-1">Нова сигурна парола</label>
                                <input type="password" asp-for="NewPassword" id="inputNewPass" class="form-control form-control-sm font-monospace border-secondary-subtle" autocomplete="off" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                            <!-- 3. ПОВТОРИ НОВАТА ПАРОЛА -->
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold mb-1">Повторете новата парола</label>
                                <input type="password" asp-for="ConfirmNewPassword" id="inputConfirmPass" class="form-control form-control-sm font-monospace border-secondary-subtle" autocomplete="off" />
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                            <!-- 4. ОБЩ ЧЕКБОКС "ПОКАЖИ ПАРОЛИТЕ" -->
                            <div class="col-12 mt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input text-primary" type="checkbox" id="globalShowPasswordsCheckbox" style="cursor: pointer;" />
                                    <label class="form-check-label text-muted small fw-bold" for="globalShowPasswordsCheckbox" style="cursor: pointer;">
                                        <i class="bi bi-eye-fill me-1"></i> Покажи въведените пароли

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Панел 3. Край -->
            </div>
        </div>
    </form>
</div>
<!-- ФАБРИЧЕН BOOTSTRAP MODAL ПРОЗОРЕЦ ЗА ПОТВЪРЖДЕНИЕ -->
<div class="modal fade" id="confirmSettingsModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-primary" id="confirmModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Потвърждение на системните промени
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="m-0 text-muted">
                    Системата ще актуализира уеб параметрите, визуалния интерфейс и настройките за сигурност на холдинга в реално време.
                </p>
                <p class="fw-bold mt-2 text-white-50">
                    Наистина ли искате да потвърдите направените промени?
                </p>
            </div>
            <div class="modal-footer border-top-0">
                <!-- ОРИГИНАЛНИ ДЕКСТОР БУТОНИ "ДА" И "НЕ" -->
                <button type="button" class="btn btn-secondary fw-bold px-3" data-bs-dismiss="modal">Не, отказ</button>
                <button type="button" class="btn btn-success fw-bold px-4" id="executeSubmitFormBtn">Да, потвърждавам</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/settings-mirror.js?v=@DateTime.Now.Ticks"></script>
