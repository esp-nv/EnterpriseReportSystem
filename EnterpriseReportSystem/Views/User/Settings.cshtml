@model EnterpriseReportSystem.Models.Entities.Structure.SystemUser

@{
    Layout = "_Layout";
    ViewData["Title"] = "Application Settings";
    var userStyles = ViewBag.UserStyles as List<EnterpriseReportSystem.Models.Entities.Structure.SystemUserTheme> ?? new();
    var uiElements = ViewBag.UIElements as List<EnterpriseReportSystem.Models.Entities.Structure.SystemUIElement> ?? new();
}

<div class="container-fluid my-4 font-sans-serif" style="background-color: #1e1e1e; color: #d4d4d4; min-height: 85vh; border: 1px solid #3c3c3c; rounded-3 shadow-lg;">

    <!-- ГОРНА СИСТЕМНА ЛЕНТА С ИМЕТО НА ПРИЛОЖЕНИЕТО -->
    <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="border-color: #3c3c3c !important; background-color: #2d2d2d;">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-window text-info fs-5"></i>
            <!-- ТОЧКА 1: Променяме уеб заглавието на чист български език -->
            <span class="fw-bold text-white small font-monospace">Потребителски настройки и Визуални теми</span>
        </div>
        <!-- ТОЧКА 2: Сменяме фабричния фреймуърк с името на текущия потребител -->
        <span class="badge bg-dark text-secondary font-monospace border border-secondary" style="font-size: 0.7rem; color: #ffc107 !important;">user: @Model.Username</span>
    </div>


    <div class="row g-0 h-100" style="min-height: 75vh;">
        <!-- ========================================================================= -->
        <!-- ЛЯВ ВЕРТИКАЛЕН СИСТЕМЕН ПАНЕЛ ПО ОФИЦИАЛЕН СТАНДАРТ НА BOOTSTRAP COLLAPSE -->
        <!-- ========================================================================= -->
        <div class="col-md-3 border-end border-secondary" style="background-color: #252526;">
            <nav class="p-3 font-monospace" id="bd-docs-nav" aria-label="Docs navigation">
                <ul class="list-unstyled mb-0 d-flex flex-column gap-1 p-0">

                    <!-- ТАБ 1: ОБЩИ НАСТРОЙКИ (ГЛАВЕН ЛИНК) -->
                    <li class="mb-1">
                        <button class="nav-link active text-start py-2 px-3 rounded-0 border-0 small text-white w-100"
                                id="tab-general" data-bs-toggle="pill" data-bs-target="#content-general" type="button" role="tab" aria-controls="content-general" aria-selected="true"
                                style="background-color: #37373d; font-size: 0.85rem;">
                            <i class="bi bi-gear-fill me-2 text-warning"></i> Общи настройки
                        </button>
                    </li>

                    <!-- ДЪРВО 2: СИСТЕМНИ ВИЗУАЛНИ ЕЛЕМЕНТИ (COLLAPSE МЕХАНИЗЪМ ТОЧНО ПО СНИМКАТА) -->
                    <li class="mb-1">
                        <!-- Бутонът, който отваря/затваря дървото автоматично през Bootstrap -->
                        <button class="btn d-inline-flex align-items-center justify-content-between text-start py-2 px-3 rounded-0 border-0 small text-white w-100 fw-bold font-monospace collapse-trigger-btn"
                                type="button" data-bs-toggle="collapse" data-bs-target="#components-collapse" aria-expanded="true" style="font-size: 0.85rem;">
                            <span><i class="bi bi-chevron-down me-2 text-muted" id="collapseChevron"></i>Системни визуални елементи</span>
                        </button>

                        <!-- Контейнерът с под-елементите, който се управлява от Bootstrap Collapse -->
                        <div class="collapse show mt-1" id="components-collapse">
                            <ul class="btn-toggle-nav list-unstyled fw-normal ps-4 ms-1 border-start border-secondary d-flex flex-column gap-1 p-0">

                                <!-- ПОД-ТАБ А: Списък с компоненти -->
                                <li>
                                    <button class="nav-link text-start py-1 px-2 rounded-0 border-0 small text-muted w-100"
                                            id="tab-elements" data-bs-toggle="pill" data-bs-target="#content-elements" type="button" role="tab" aria-controls="content-elements" aria-selected="false"
                                            style="font-size: 0.8rem; background: transparent;">
                                        Списък с компоненти
                                    </button>
                                </li>

                                <!-- ПОД-ТАБ Б: Персонални свойства и теми -->
                                <li>
                                    <button class="nav-link text-start py-1 px-2 rounded-0 border-0 small text-muted w-100"
                                            id="tab-themes" data-bs-toggle="pill" data-bs-target="#content-themes" type="button" role="tab" aria-controls="content-themes" aria-selected="false"
                                            style="font-size: 0.8rem; background: transparent;">
                                        Персонални свойства и теми
                                    </button>
                                </li>

                            </ul>
                        </div>
                    </li>

                    <li class="my-2 border-top border-secondary"></li>

                    <!-- ТАБ 4: ПОТРЕБИТЕЛСКИ ПРОФИЛ -->
                    <li class="mb-1">
                        <button class="nav-link text-start py-2 px-3 rounded-0 border-0 small text-muted w-100"
                                id="tab-user-props" data-bs-toggle="pill" data-bs-target="#content-user-props" type="button" role="tab" aria-controls="content-user-props" aria-selected="false"
                                style="font-size: 0.85rem; background: transparent;">
                            <i class="bi bi-person-vcard-fill me-2 text-info"></i> Потребителски профил
                        </button>
                    </li>

                </ul>
            </nav>
        </div>


        <!-- ========================================================================= -->
        <!-- ДЕСЕН ГОЛЯМ КОНТЕНЕР СЪС СЪДЪРЖАНИЕТО НА ТАБОВЕТЕ                          -->
        <!-- ========================================================================= -->
        <div class="col-md-9 p-4" style="background-color: #1e1e1e;">
            <form asp-action="SaveSettings" asp-controller="User" method="post" class="needs-validation h-100 d-flex flex-column justify-content-between" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="tab-content flex-grow-1" id="vs-tab-content">

                    <!-- РАЗДЕЛ 1: ОСНОВНИ НАСТРОЙКИ (APPLICATION) -->
                    <div class="tab-pane fade show active" id="content-general" role="tabpanel" aria-labelledby="tab-general">
                        <h4 class="text-white fw-light mb-1" style="font-size: 1.6rem;">Основни настройки</h4>
                        <span class="text-muted small d-block mb-4 pb-2 border-bottom font-monospace" style="border-color: #3c3c3c !important;">Управление на глобалната визуална тема и структура на потребителския интерфейс.</span>

                        <div class="row g-4 font-monospace" style="font-size: 0.85rem;">
                            <div class="col-md-8">
                                <label asp-for="LayoutType" class="form-label fw-bold text-secondary mb-1">Вид на главното меню</label>
                                <select asp-for="LayoutType" id="layoutSelector" class="form-select form-select-sm rounded-1 text-white border-secondary font-monospace" style="background-color: #333333 !important; border-color: #555555 !important;">
                                    <option value="RIBBON">Хоризонтална лента тип RIBBON UI</option>
                                    <option value="DASHBOARD">Вертикален страничен контролен панел</option>
                                </select>
                                <span class="text-muted small d-block mt-1">Определя разположението на основните навигационни връзки в системата.</span>
                            </div>

                            <div class="col-md-8 mt-4">
                                <label asp-for="ThemeType" class="form-label fw-bold text-secondary mb-1">Режим на уеб темата</label>
                                <select asp-for="ThemeType" id="themeSelector" class="form-select form-select-sm rounded-1 text-white border-secondary font-monospace" style="background-color: #333333 !important; border-color: #555555 !important;">
                                    <option value="light">Класическа Светла Офис Тема (Light Web)</option>
                                    <option value="dark">Класическа Тъмна Офис Тема (Dark Web)</option>
                                    <option value="custom">Персонална потребителска палитра (Custom Palette)</option>
                                    <option value="external">Външен CSS модул (External user.css)</option>
                                </select>
                                <span class="text-muted small d-block mt-1">Избор на базов цветови енджин за визуализация на оперативния екран.</span>
                            </div>
                        </div>
                    </div>

                    <!-- РАЗДЕЛ 2: СИСТЕМНИ ВИЗУАЛНИ ЕЛЕМЕНТИ (SYSTEMUIELEMENTS) -->
                    <div class="tab-pane fade" id="content-elements" role="tabpanel" aria-labelledby="tab-elements">
                        <h4 class="text-white fw-light mb-1" style="font-size: 1.6rem;">Системни визуални елементи</h4>
                        <span class="text-muted small d-block mb-4 pb-2 border-bottom font-monospace" style="border-color: #3c3c3c !important;">Списък с основните хардуерно и софтуерно фиксирани зони на потребителския интерфейс.</span>

                        <div class="table-responsive rounded-1 font-monospace" style="font-size: 0.8rem; border: 1px solid #3c3c3c;">
                            <table class="table table-sm table-dark table-striped mb-0 align-middle" style="background-color: #252526;">
                                <thead style="background-color: #2d2d2d; color: #858585; font-size: 0.75rem;">
                                    <tr>
                                        <th class="px-3 py-2 border-0" style="width: 10%;">ID</th>
                                        <th class="py-2 border-0" style="width: 50%;">Наименование на интерфейсната зона</th>
                                        <th class="py-2 text-end px-3 border-0" style="width: 40%;">Уникален системен ключ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (uiElements != null && uiElements.Any())
                                    {
                                        @foreach (var element in uiElements)
                                        {
                                            <tr style="border-color: #3c3c3c !important;">
                                                <td class="px-3 fw-bold text-info">@element.Id</td>
                                                <td class="text-white">@element.DisplayName</td>
                                                <td class="text-end text-warning px-3 font-monospace" style="font-size: 0.75rem;">@element.ElementKey</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center py-4 text-muted font-monospace small">
                                                <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Няма заредени системни елементи в SQL Server.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>


                    <!-- РАЗДЕЛ 3: SYSTEMUSERTHEMES (АТОМАРНИТЕ СВОЙСТВА И КОМБОБОКСОВЕ) -->
                    <div class="tab-pane fade" id="content-themes" role="tabpanel" aria-labelledby="tab-themes">
                        <h4 class="text-white fw-light mb-1" style="font-size: 1.6rem;">SystemUserThemes</h4>
                        <span class="text-muted small d-block mb-4 pb-2 border-bottom font-monospace" style="border-color: #3c3c3c !important;">Atomic properties binding context orchestration layout profiles.</span>

                        <div class="row g-3 font-monospace" style="font-size: 0.85rem;">
                            @foreach (var themeStyle in userStyles)
                            {
                                <div class="col-md-9 mb-3">
                                    <label class="form-label fw-bold text-secondary mb-1">
                                        <i class="bi bi-terminal-fill text-info me-1"></i> @themeStyle.Description
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-dark border-secondary text-muted" style="font-size: 0.7rem; border-color: #555555 !important;">Token:</span>
                                        <select name="BootstrapClasses[@themeStyle.Id]" class="form-select form-select-sm text-white font-monospace" style="background-color: #333333 !important; border-color: #555555 !important; font-size: 0.75rem;">
                                            <option value="@themeStyle.BootstrapClass" selected>@themeStyle.BootstrapClass (Current value)</option>
                                            @if (themeStyle.ElementContext.Contains("background"))
                                            {
                                                <option value="bg-dark">bg-dark (Default Dark Slate)</option>
                                                <option value="bg-light">bg-light (Standard Office Pure)</option>
                                            }
                                            @if (themeStyle.ElementContext.Contains("table"))
                                            {
                                                <option value="table-dark table-striped">table-dark (Accounting Dense Grid Style)</option>
                                                <option value="table-light table-striped">table-light (Accounting Office White Grid)</option>
                                            }
                                            @if (themeStyle.ElementContext.Contains("shadow"))
                                            {
                                                <option value="shadow">shadow (Medium Layout Depth)</option>
                                                <option value="shadow-lg">shadow-lg (High Luxury Depth)</option>
                                                <option value="shadow-none">shadow-none (Flat Macro Surface)</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            }

                            <!-- HEX ПОТРЕБИТЕЛСКИ ПАЛИТРИ НА ДЪНОТО НА ПРОЗОРЕЦА -->
                            <div class="col-md-9 mt-4 pt-3 border-top" style="border-color: #3c3c3c !important;">
                                <h6 class="text-secondary fw-bold mb-3 small text-uppercase"><i class="bi bi-sliders2-vertical me-2"></i> Custom Palette Parameters Override</h6>
                                <div class="row text-center g-3">
                                    <div class="col-4">
                                        <label class="form-label small d-block text-muted">Background HEX</label>
                                        <input type="color" class="form-control form-control-color mx-auto rounded-0 border-secondary bg-transparent p-0" id="bgColorPicker" value="#141414" disabled style="width: 35px; height: 35px;">
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label small d-block text-muted">Accent HEX</label>
                                        <input type="color" class="form-control form-control-color mx-auto rounded-0 border-secondary bg-transparent p-0" id="accentColorPicker" value="#ff5500" disabled style="width: 35px; height: 35px;">
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label small d-block text-muted">Foreground HEX</label>
                                        <input type="color" class="form-control form-control-color mx-auto rounded-0 border-secondary bg-transparent p-0" id="textColorPicker" value="#e0e0e0" disabled style="width: 35px; height: 35px;">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ГОЛЕМИЯТ СИСТЕМЕН ЗАПЕЧАТВАЩ БУТОН ЗА СЪХРАНЕНИЕ НА ПРОФИЛА -->
                <div class="mt-4 pt-3 border-top text-end" style="border-color: #3c3c3c !important;">
                    <button type="submit" class="btn btn-sm px-4 fw-bold font-monospace rounded-0 text-white"
                            style="background-color: #007acc; border: 1px solid #0062a3; font-size: 0.8rem; letter-spacing: 0.5px;">
                        <i class="bi bi-save2 me-2 text-warning"></i> Save Application Properties
                    </button>
                </div>
            </form>
        </div>

    </div> <!-- Край на .row -->
</div> <!-- Край на .container-fluid -->

<style>
    /* АВТЕНТИЧЕН VISUAL STUDIO СТИЛ ЗА СТРАНИЧНИТЕ СИСТЕМНИ ТАБОВЕ */
    #vs-tab-system .nav-link {
        color: #aaaaaa !important;
        border-left: 2px solid transparent !important;
        transition: all 0.15s ease-in-out;
    }

        #vs-tab-system .nav-link.active {
            background-color: #2a2a2b !important;
            color: #ffffff !important;
            border-left: 2px solid #007acc !important;
        }

        #vs-tab-system .nav-link:hover:not(.active) {
            background-color: #2d2d2d !important;
            color: #ffffff !important;
        }

    .text-light-muted {
        color: #858585 !important;
    }
</style>
