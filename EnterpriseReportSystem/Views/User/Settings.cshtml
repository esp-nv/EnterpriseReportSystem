@model EnterpriseReportSystem.Models.Entities.Structure.SystemUser

@{
    Layout = "_Layout";
    ViewData["Title"] = "Application Settings";
    var userStyles = ViewBag.UserStyles as List<EnterpriseReportSystem.Models.Entities.Structure.SystemUserTheme> ?? new();
    var uiElements = ViewBag.UIElements as List<EnterpriseReportSystem.Models.Entities.Structure.SystemUIElement> ?? new();
}

<!-- ГЛАВЕН КОНТЕНЕР, ОБГЪРНАТ В ЧИСТА ФОРМА ОЩЕ ОТ САМОТО НАЧАЛО -->
<form asp-action="SaveSettings" asp-controller="User" method="post" class="needs-validation m-0 p-0" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="container-fluid my-4 font-sans-serif" style="background-color: #1e1e1e; color: #d4d4d4; min-height: 85vh; border: 1px solid #3c3c3c; border-radius: 4px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">

        <!-- ГОРНА СИСТЕМНА ЛЕНТА С ИМЕТО НА ПРИЛОЖЕНИЕТО -->
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="border-color: #3c3c3c !important; background-color: #2d2d2d; margin-left: -12px; margin-right: -12px;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-window text-info fs-5"></i>
                <span class="fw-bold text-white small font-monospace">Потребителски настройки и Визуални теми</span>
            </div>
            <span class="badge bg-dark text-secondary font-monospace border border-secondary" style="font-size: 0.7rem; color: #ffc107 !important;">user: @Model.Username</span>
        </div>

        <div class="row g-0" style="min-height: 75vh;">


            <!-- ========================================================================= -->
            <!-- ЛЯВ ВЕРТИКАЛЕН СИСТЕМЕН ПАНЕЛ (ФИКСИРАН JS И ОПРЕДЕЛЕНО ОТСТОЯНИЕ)         -->
            <!-- ========================================================================= -->
            <div class="col-md-3 border-end font-monospace" style="border-color: #3c3c3c !important; background-color: #252526; min-height: 75vh;">

                <!-- ГОРНА ЧАСТ: КОНФИГУРАТОР СЪС СЛЕПЕНИ ВЕРТИКАЛНИ БУТОНИ С РАМКА -->
                <div class="p-3 pb-0">
                    <div class="text-uppercase text-secondary font-monospace px-2 pt-2 pb-2 fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                        <i class="bi bi-sliders me-1 text-info"></i> Конфигуратор на теми
                    </div>

                    <!-- ФИКСИРАНО ID: Връщаме id="vs-tab-system", за да проработи JS на секундата -->
                    <div class="btn-group-vertical w-100 font-monospace shadow-sm" id="vs-tab-system" role="tablist" aria-orientation="vertical">

                        <!-- БУТОН 1: Общи настройки -->
                        <button class="nav-link active btn btn-sm text-start py-2 px-3 rounded-0 border border-secondary text-white position-relative"
                                id="tab-general-btn" data-bs-toggle="pill" data-bs-target="#content-general" type="button" role="tab" aria-controls="content-general" aria-selected="true"
                                style="font-size: 0.85rem; background-color: #37373d;">
                            <i class="bi bi-gear-fill me-2 text-warning"></i> Общи настройки
                        </button>

                        <!-- БУТОН 2: Системни визуални елементи -->
                        <button class="nav-link btn btn-sm text-start py-2 px-3 rounded-0 border border-secondary text-muted"
                                id="tab-elements-btn" data-bs-toggle="pill" data-bs-target="#content-elements" type="button" role="tab" aria-controls="content-elements" aria-selected="false"
                                style="font-size: 0.85rem; background-color: transparent;">
                            <i class="bi bi-layers-half me-2 text-success"></i> Системни визуални елементи
                        </button>

                        <!-- БУТОН 3: Потребителски профил -->
                        <button class="nav-link btn btn-sm text-start py-2 px-3 rounded-0 border border-secondary text-muted"
                                id="tab-user-props-btn" data-bs-toggle="pill" data-bs-target="#content-user-props" type="button" role="tab" aria-controls="content-user-props" aria-selected="false"
                                style="font-size: 0.85rem; background-color: transparent;">
                            <i class="bi bi-person-vcard-fill me-2 text-info"></i> Потребителски профил
                        </button>

                    </div>
                </div>

                <!-- ПОПРАВКА: Твърдо отстояние mt-5 (точно колкото 1 таб разстояние под списъка) и махане на mt-auto -->
                <div class="w-100 px-3 pb-3 mt-5">
                    <button type="submit" class="btn btn-sm btn-primary shadow-sm font-monospace rounded-1 border-0 w-100 py-2 fs-6">
                        <i class="bi bi-cloud-check-fill me-2 text-warning"></i> Запечатай настройките
                    </button>
                </div>

            </div>



            <!-- ========================================================================= -->
            <!-- ДЕСЕН ГОЛЯМ КОНТЕНЕР С ЧИСТ ФАБРИЧЕН TAB-CONTENT МЕХАНИЗЪМ                 -->
            <!-- ========================================================================= -->
            <div class="col-md-9 p-4" style="background-color: #1e1e1e;">
                <div class="tab-content h-100" id="vs-tab-content-panes">

                    <!-- ----------------------------------------------------------------- -->
                    <!-- ПАНЕЛ 1: ОБЩИ НАСТРОЙКИ (АКТИВЕН ПО ПОДРАЗБИРАНЕ)                 -->
                    <!-- ----------------------------------------------------------------- -->
                    <div class="tab-pane fade show active" id="content-general" role="tabpanel" aria-labelledby="tab-general-btn">
                        <h4 class="text-white fw-light mb-1" style="font-size: 1.6rem;">Общи настройки</h4>
                        <span class="text-muted small d-block mb-4 pb-2 border-bottom font-monospace" style="border-color: #3c3c3c !important;">Управление на глобалната визуална тема и структура на потребителския интерфейс.</span>

                        <div class="row g-4 font-monospace" style="font-size: 0.85rem;">
                            <div class="col-md-8">
                                <label class="form-label fw-bold text-secondary mb-1">Вид на главното меню</label>
                                <select name="LayoutType" id="layoutSelector" class="form-select form-select-sm text-white font-monospace" style="background-color: #333333 !important; border-color: #555555 !important;">
                                    <option value="RIBBON" selected="@(Model.LayoutType == "RIBBON" ? "selected" : null)">Хоризонтална лента тип RIBBON UI</option>
                                    <option value="DASHBOARD" selected="@(Model.LayoutType == "DASHBOARD" ? "selected" : null)">Вертикален страничен контролен панел</option>
                                </select>
                            </div>

                            <div class="col-md-8 mt-4">
                                <label class="form-label fw-bold text-secondary mb-1">Режим на уеб темата</label>
                                <select name="ThemeType" id="themeSelector" class="form-select form-select-sm text-white font-monospace" style="background-color: #333333 !important; border-color: #555555 !important;">
                                    <option value="dark" selected="@(Model.ThemeType == "dark" ? "selected" : null)">Класическа Тъмна Офис Тема (Dark Web)</option>
                                    <option value="light" selected="@(Model.ThemeType == "light" ? "selected" : null)">Класическа Светла Офис Тема (Light Web)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- ----------------------------------------------------------------- -->
                    <!-- ПАНЕЛ 2: СИСТЕМНИ ВИЗУАЛНИ ЕЛЕМЕНТИ                              -->
                    <!-- ----------------------------------------------------------------- -->
                    <div class="tab-pane fade" id="content-elements" role="tabpanel" aria-labelledby="tab-elements-btn">
                        <h4 class="text-white fw-light mb-1" style="font-size: 1.6rem;">Системни визуални елементи</h4>
                        <span class="text-muted small d-block mb-4 pb-2 border-bottom font-monospace" style="border-color: #3c3c3c !important;">Списък с основните фиксирани зони на потребителския интерфейс от базата данни.</span>

                        <div class="table-responsive rounded-1 font-monospace mb-4" style="font-size: 0.8rem; border: 1px solid #3c3c3c;">
                            <table class="table table-sm table-dark table-striped mb-0 align-middle" style="background-color: #252526;">
                                <thead style="background-color: #2d2d2d; color: #858585; font-size: 0.75rem;">
                                    <tr>
                                        <th class="px-3 py-2 border-0" style="width: 10%;">ID</th>
                                        <th class="py-2 border-0" style="width: 50%;">Наименование на интерфейсната зона</th>
                                        <th class="py-2 text-end px-3 border-0" style="width: 40%;">Уникален системен ключ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var element in uiElements)
                                    {
                                        <tr style="border-color: #3c3c3c !important;">
                                            <td class="px-3 fw-bold text-info">@element.Id</td>
                                            <td class="text-white">@element.DisplayName</td>
                                            <td class="text-end text-warning px-3 font-monospace" style="font-size: 0.75rem;">@element.ElementKey</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- СЕКЦИЯ 3: ТРИТЕ БУТОНА ЗА УПРАВЛЕНИЕ -->
                        <div class="card border-0 p-4 rounded-1 mb-3" style="background-color: #252526; border: 1px solid #3c3c3c !important;">
                            <h6 class="text-white fw-bold mb-3 small text-uppercase border-bottom pb-2" style="border-color: #3c3c3c !important;">
                                <i class="bi bi-palette text-danger me-2"></i> Параметри и свойства на уеб темата
                            </h6>

                            <div class="d-flex gap-2 mb-4">
                                <button class="btn btn-sm btn-secondary font-monospace px-3 fw-bold rounded-1 text-white border-secondary" type="button" id="props-btn-general" style="background-color: #007acc; border-color: #0062a3 !important;">1. Общи настройки</button>
                                <button class="btn btn-sm btn-dark font-monospace px-3 fw-bold rounded-1 text-muted border-secondary" type="button" id="props-btn-custom" style="background-color: #333333;">2. Персонални настройки</button>
                                <button class="btn btn-sm btn-dark font-monospace px-3 fw-bold rounded-1 text-muted border-secondary" type="button" id="props-btn-external" style="background-color: #333333;">3. Външна тема / CSS</button>
                            </div>

                            <div class="row g-3 font-monospace" style="font-size: 0.85rem;">
                                @foreach (var themeStyle in userStyles)
                                {
                                    <div class="col-md-12 mb-2">
                                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;"><i class="bi bi-terminal-fill text-info me-1"></i> @themeStyle.Description</label>
                                        <select name="BootstrapClasses[@themeStyle.Id]" class="form-select form-select-sm text-white font-monospace" style="background-color: #333333 !important; border-color: #555555 !important; font-size: 0.75rem;">
                                            <option value="@themeStyle.BootstrapClass" selected>@themeStyle.BootstrapClass (Текущ токен)</option>
                                            @if (themeStyle.ElementContext.Contains("background"))
                                            {
                                                <option value="bg-dark">bg-dark (Тъмен графит)</option>
                                                <option value="bg-light">bg-light (Чист офис светъл)</option>
                                            }
                                            @if (themeStyle.ElementContext.Contains("table"))
                                            {
                                                <option value="table-dark table-striped">table-dark (Тъмна решетка)</option>
                                                <option value="table-light table-striped">table-light (Светла решетка)</option>
                                            }
                                            @if (themeStyle.ElementContext.Contains("shadow"))
                                            {
                                                <option value="shadow">shadow (Средна сянка)</option>
                                                <option value="shadow-lg">shadow-lg (Дълбока сянка)</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- ----------------------------------------------------------------- -->
                    <!-- ПАНЕЛ 3: ПОТРЕБИТЕЛСКИ ПРОФИЛ                                     -->
                    <!-- ----------------------------------------------------------------- -->
                    <div class="tab-pane fade" id="content-user-props" role="tabpanel" aria-labelledby="tab-user-props-btn">
                        <h4 class="text-white fw-light mb-1" style="font-size: 1.6rem;">Потребителски профил</h4>
                        <span class="text-muted small d-block mb-4 pb-2 border-bottom font-monospace" style="border-color: #3c3c3c !important;">Управление на потребителските идентификатори и права за достъп в холдинга.</span>

                        <div class="row g-3 font-monospace" style="font-size: 0.85rem;">
                            <div class="col-md-8 mb-2">
                                <label class="form-label fw-bold text-secondary mb-1">Потребителско име</label>
                                <input type="text" name="Username" value="@Model.Username" class="form-control form-control-sm text-white font-monospace bg-dark border-secondary" style="background-color: #333333 !important; border-color: #555555 !important;" required />
                            </div>
                            <div class="col-md-8 mb-2">
                                <label class="form-label fw-bold text-secondary mb-1">Парола за достъп</label>
                                <input type="password" name="Password" value="@Model.Password" class="form-control form-control-sm text-white font-monospace bg-dark border-secondary" style="background-color: #333333 !important; border-color: #555555 !important;" required />
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div> <!-- Край на .row -->
    </div> <!-- Край на .container-fluid -->
</form>

<style>
    #vs-tab-system .nav-link {
        color: #aaaaaa !important;
        border-left: 2px solid transparent !important;
        transition: none;
    }

        #vs-tab-system .nav-link.active {
            border-left: 2px solid #007acc !important;
        }

        #vs-tab-system .nav-link:hover:not(.active) {
            background-color: #2d2d2d !important;
            color: #ffffff !important;
        }
</style>
