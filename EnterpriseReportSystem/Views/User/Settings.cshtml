@model EnterpriseReportSystem.Models.Entities.Structure.SystemUser
@using EnterpriseReportSystem.Models.Entities.Structure
@using EnterpriseReportSystem.Common.Enum

@{
    ViewData["Title"] = "Потребителски настройки и Визуални теми";
}

<div class="container-fluid py-4 @ViewData["TextClass"]">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-light mb-1">Потребителски настройки и Визуални теми</h4>
            <small class="text-muted font-monospace">Интегрирано управление на уеб параметрите и стиловите конфигурации на холдинга.</small>
        </div>
    </div>

    <form asp-action="SaveSettings" asp-controller="User" method="post" class="row g-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Username" />
        <input type="hidden" asp-for="Password" />
        <input type="hidden" asp-for="CompanyId" />

        <!-- ЛЯВ ПАНЕЛ: НАВИГАЦИОННИ ТАБОВЕ -->
        <div class="col-md-3">
            <div class="card @ViewData["CardStyleClass"] p-3">
                <div class="nav flex-column nav-pills" id="vs-tab-system" role="tabpanel">
                    <button class="nav-link active text-start mb-2" id="tab-profile-btn" data-bs-toggle="pill" data-bs-target="#content-profile" type="button" role="tab">
                        <i class="bi bi-person-fill me-2"></i> Потребителски профил
                    </button>
                    <button class="nav-link text-start" id="tab-elements-btn" data-bs-toggle="pill" data-bs-target="#content-elements" type="button" role="tab">
                        <i class="bi bi-sliders me-2"></i> Системни елементи
                    </button>
                </div>
                <hr />
                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="bi bi-shield-check me-2"></i> Запечатай настройките
                </button>
            </div>
        </div>

        <!-- ДЕСЕН ПАНЕЛ: ДИНАМИЧНО СЪДЪРЖАНИЕ -->
        <div class="col-md-9">
            <div class="tab-content" id="vs-tab-content">

                <!-- ПАНЕЛ 1: ПОТРЕБИТЕЛСКИ ПРОФИЛ -->
                <div class="tab-pane fade show active" id="content-profile" role="tabpanel">
                    <div class="card @ViewData["CardStyleClass"] p-4">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">
                            <i class="bi bi-person-badge text-primary me-2"></i> Профилни данни на оператора
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Име на оператора</label>
                                <input type="text" class="form-control form-control-sm font-monospace" value="@Model.Username" disabled />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Системна роля</label>
                                <input type="text" class="form-control form-control-sm font-monospace" value="@(Model.IsGlobalAdmin ? "Глобален Администратор" : "Оператор")" disabled />
                            </div>
                            <!-- ДОБАВЕНО: ПОЛЕ ЗА ПАРОЛА С ИКОНА ОКО -->
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Системна парола</label>
                                <div class="input-group input-group-sm">
                                    <input type="password" name="Password" id="operatorPasswordInput" class="form-control font-monospace border-end-0" value="@Model.Password" autocomplete="off" />
                                    <button class="input-group-text bg-transparent text-secondary border-start-0" type="button" id="togglePasswordVisibilityBtn" style="cursor: pointer;">
                                        <i class="bi bi-eye" id="passwordEyeIcon"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- ПАНЕЛ 2: СИСТЕМНИ ВИЗУАЛНИ ЕЛЕМЕНТИ -->
                <div class="tab-pane fade" id="content-elements" role="tabpanel">

                                        <!-- 1. ГЛОБАЛНИ ПАРАМЕТРИ -->
                    <div class="card @ViewData["CardStyleClass"] p-4 mb-4">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">
                            <i class="bi bi-gear-fill text-warning me-2"></i> Глобални параметри (Общи настройки)
                        </h5>
                        <div class="row g-3 align-items-end">
                            <div class="col-md-8">
                                <label class="form-label fw-bold small">Вид на главното меню</label>
                                <select name="LayoutType" id="layoutSelector" class="form-select form-select-sm font-monospace">
                                    <option value="1" selected="@(Model.LayoutType == AppLayoutType.Dashboard ? "selected" : null)">Вертикален страничен контролен панел</option>
                                    <option value="2" selected="@(Model.LayoutType == AppLayoutType.Ribbon ? "selected" : null)">Хоризонтална лента тип MS Excel / Word (Ribbon)</option>
                                    <option value="3" selected="@(Model.LayoutType == AppLayoutType.Navbar ? "selected" : null)">Хоризонтална лента тип NAVBAR</option>
                                </select>
                            </div>
                            <!-- ДОБАВЕНО: ПРЕВКЛЮЧВАТЕЛ ЗА РАЗПЪНАТО / СЪБРАНО СЪСТОЯНИЕ НА МЕНЮТО -->
                            <div class="col-md-4">
                                <div class="form-check form-switch mb-1">
                                    <input class="form-check-input" type="checkbox" name="IsMenuExpanded" id="isMenuExpandedSwitch" value="true" checked="@(Model.IsMenuExpanded ? "checked" : null)" style="cursor: pointer;" />
                                    <input type="hidden" name="IsMenuExpanded" value="false" />
                                    <label class="form-check-label text-muted small fw-bold" for="isMenuExpandedSwitch">
                                        <i class="bi bi-layout-sidebar-inset me-1"></i> Разпънато главно меню
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>


                    <!-- 2. КОНФИГУРАТОР НА СТИЛОВЕ (GROUP BOX) -->
                    <div class="card @ViewData["CardStyleClass"] p-4 mb-4">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">
                            <i class="bi bi-palette-fill text-info me-2"></i> Конфигуратор на стилови файлове (bootstrap.build)
                        </h5>
                        <div class="row g-3">
                            <!-- РАДИО БУТОНИ -->
                            <h5 class="fw-bold mb-3 border-bottom pb-2">
                                <i class="bi bi-circle-half text-primary me-2"></i> Контраст на околната среда (Глобален Режим)
                            </h5>

                            <div class="col-md-4 border-end border-secondary pe-3">
                                <div class="form-check">
                                    <input class="form-check-input mode-contrast-radio" type="radio" name="IsDarkUserPreference" id="modeLightRadio" value="false" checked="@(!Model.IsDarkUserPreference ? "checked" : null)">
                                    <label class="form-check-label" for="modeLightRadio">☀️ Светъл уеб режим</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input mode-contrast-radio" type="radio" name="IsDarkUserPreference" id="modeDarkRadio" value="true" checked="@(Model.IsDarkUserPreference ? "checked" : null)">
                                    <label class="form-check-label fw-bold" for="modeDarkRadio">🌙 Тъмен конзолен профил</label>
                                </div>
                               
                            </div>

                            <!-- СЕЛЕКТОР ЗА ТЕМИ -->
                            <div class="col-md-8 ps-md-3">
                                <label class="form-label fw-bold small">Произход на стила</label>
                                <div class="form-check mb-2">
                                    <input class="form-check-input theme-source-radio" type="radio" name="IsCustomPaletteActive" 
                                    id="radioFactoryStyle" value="false" checked="@(!Model.IsCustomPaletteActive ? "checked" : null)">
                                    <label class="form-check-label" for="radioFactoryStyle">
                                        <i class="bi bi-cpu me-1"></i> Фабричен Bootstrap изглед
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input theme-source-radio" type="radio" name="IsCustomPaletteActive"
                                    id="radioCustomStyle" value="true" checked="@(Model.IsCustomPaletteActive ? "checked" : null)">
                                    <label class="form-check-label" for="radioCustomStyle">
                                        <i class="bi bi-file-earmark-code me-1 text-success"></i> Персонализирана тема (Външен файл)
                                    </label>
                                    <select name="ThemeId" id="themeIdDropdown" class="form-select form-select-sm font-monospace">
                                        @if (ViewBag.GlobalThemes != null)
                                        {
                                            foreach (var theme in (List<GlobalTheme>)ViewBag.GlobalThemes)
                                            {
                                                string square = theme.SupportType ? "⬛" : "⬜";
                                                string isDarkString = theme.SupportType ? "true" : "false";

                                                if (Model.ThemeId == theme.Id)
                                                {
                                                    <option value="@theme.Id" data-file="@theme.FileName" data-dark="@isDarkString" selected="selected">✓ @square @theme.ThemeName</option>
                                                }
                                                else
                                                {
                                                    <option value="@theme.Id" data-file="@theme.FileName" data-dark="@isDarkString">@square @theme.ThemeName</option>
                                                }
                                            }
                                        }
                                    </select>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </form>
</div>
<!-- ПРИНУДИТЕЛНО ЗАРЕЖДАНЕ НА НОВИЯ СКРИПТ БЕЗ ИНТЕРФЕЙСЕН КЕШ -->
<script src="~/js/settings-mirror.js?v=@DateTime.Now.Ticks"></script>
