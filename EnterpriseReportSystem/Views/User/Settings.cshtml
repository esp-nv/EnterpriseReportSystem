@model EnterpriseReportSystem.Models.Entities.Structure.SystemUser

@{
    Layout = "_Layout";
    ViewData["Title"] = "Application Settings";
  //  var userStyles = ViewBag.UserStyles as List<EnterpriseReportSystem.Models.Entities.Structure.SystemUserTheme> ?? new();
   // var uiElements = ViewBag.UIElements as List<EnterpriseReportSystem.Models.Entities.Structure.SystemUIElement> ?? new();
}

<form asp-action="SaveSettings" asp-controller="User" method="post" class="needs-validation m-0 p-0" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="container-fluid my-4 font-sans-serif" style="background-color: #1e1e1e; color: #d4d4d4; min-height: 85vh; border: 1px solid #3c3c3c; border-radius: 4px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">

        <!-- ГОРНА СИСТЕМНА LЕНТА С ИМЕТО НА ПРИЛОЖЕНИЕТО -->
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="border-color: #3c3c3c !important; background-color: #2d2d2d; margin-left: -12px; margin-right: -12px;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-window text-info fs-5"></i>
                <span class="fw-bold text-white small font-monospace">Потребителски настройки и Визуални теми</span>
            </div>
            <span class="badge bg-dark text-secondary font-monospace border border-secondary" style="font-size: 0.7rem; color: #ffc107 !important;">user: @Model.Username</span>
        </div>

        <div class="row g-0" style="min-height: 75vh;">

            <!-- ========================================================================= -->
            <!-- ЛЯВ ВЕРТИКАЛЕН СИСТЕМЕН ПАНЕЛ (ДВА ОФИЦИАЛНИ ТАБА)                        -->
            <!-- ========================================================================= -->
            <div class="col-md-3 border-end" style="border-color: #3c3c3c !important; background-color: #252526; min-height: 75vh;">

                <div class="text-uppercase text-secondary font-monospace px-3 pt-3 pb-1 fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                    <i class="bi bi-sliders me-1 text-info"></i> Конфигуратор на теми
                </div>

                <!-- СИСТЕМНИ ТАБОВЕ -->
                <div class="nav flex-column nav-pills p-3 gap-2" id="vs-tab-system" role="tablist" aria-orientation="vertical">

                    <!-- БУТОН 1: Потребителски профил (Активен по подразбиране) -->
                    <button class="nav-link active text-start py-2 px-3 rounded-0 font-monospace border border-primary small text-white position-relative"
                            id="tab-user-props-btn" data-bs-toggle="pill" data-bs-target="#content-user-props" type="button" role="tab" aria-controls="content-user-props" aria-selected="true"
                            style="font-size: 0.85rem;">
                        <i class="bi bi-person-vcard-fill me-2 text-info"></i> Потребителски профил
                    </button>

                    <!-- БУТОН 2: Системни визуални елементи -->
                    <button class="nav-link text-start py-2 px-3 rounded-0 font-monospace border border-primary small text-muted"
                            id="tab-elements-btn" data-bs-toggle="pill" data-bs-target="#content-elements" type="button" role="tab" aria-controls="content-elements" aria-selected="false"
                            style="font-size: 0.85rem;">
                        <i class="bi bi-layers-half me-2 text-success"></i> Системни визуални елементи
                    </button>

                </div>

                <!-- БУТОН ЗА ЗАПИС: Статичен с малък горен отстъп mt-2 -->
                <div class="w-100 px-3 pb-3 mt-lg-5">
                    <button type="submit" class="btn btn-sm btn-primary shadow-sm font-monospace rounded-1 border-0 w-100 py-2 fs-6">
                        <i class="bi bi-cloud-check-fill me-2 text-warning"></i> Запечатай настройките
                    </button>
                </div>

            </div>

            <!-- ========================================================================= -->
            <!-- ДЕСЕН ГОЛЯМ КОНТЕНЕР СЪС СИНХРОНИЗИРАНИ ТАБ-ПАНЕЛИ                         -->
            <!-- ========================================================================= -->
            <div class="col-md-9 p-4" style="background-color: #1e1e1e;">
                <div class="tab-content h-100" id="vs-tab-content-panes">

                    <!-- ----------------------------------------------------------------- -->
                    <!-- ПАНЕЛ 1: ПОТРЕБИТЕЛСКИ ПРОФИЛ (АКТИВЕН В НАЧАЛОТО)                -->
                    <!-- ----------------------------------------------------------------- -->
                    <div class="tab-pane fade show active" id="content-user-props" role="tabpanel" aria-labelledby="tab-user-props-btn">
                        <h4 class="text-white fw-light mb-1" style="font-size: 1.6rem;">Потребителски профил</h4>
                        <span class="text-muted small d-block mb-4 pb-2 border-bottom font-monospace" style="border-color: #3c3c3c !important;">Управление на потребителските идентификатори и права за достъп в холдинга.</span>

                        <div class="row g-3 font-monospace" style="font-size: 0.85rem;">
                            <div class="col-md-8 mb-2">
                                <label class="form-label fw-bold text-secondary mb-1">Потребителско име</label>
                                <input type="text" name="Username" value="@Model.Username" class="form-control form-control-sm text-white font-monospace bg-dark border-secondary" style="background-color: #333333 !important; border-color: #555555 !important;" required />
                            </div>
                            <div class="col-md-8 mb-2">
                                <label class="form-label fw-bold text-secondary mb-1">Парола за достъп</label>
                                <input type="password" name="Password" value="@Model.Password" class="form-control form-control-sm text-white font-monospace bg-dark border-secondary" style="background-color: #333333 !important; border-color: #555555 !important;" required />
                            </div>
                        </div>
                    </div>

                    <!-- ----------------------------------------------------------------- -->
                    <!-- ПАНЕЛ 2: СИСТЕМНИ ВИЗУАЛНИ ЕЛЕМЕНТИ                              -->
                    <!-- ----------------------------------------------------------------- -->
                    <div class="tab-pane fade" id="content-elements" role="tabpanel" aria-labelledby="tab-elements-btn">
                        <h4 class="text-white fw-light mb-1" style="font-size: 1.6rem;">Системни визуални елементи</h4>
                        <span class="text-muted small d-block mb-4 pb-2 border-bottom font-monospace" style="border-color: #3c3c3c !important;">Интегрирано управление на базовите уеб параметри и фиксираните интерфейсни зони.</span>

                        <!-- 1. ОБЩИ НАСТРОЙКИ (ГЛОБАЛНИ ПАРАМЕТРИ НАЙ-ОТГОРЕ) -->
                        <div class="card border-0 p-4 rounded-1 mb-4" style="background-color: #252526; border: 1px solid #3c3c3c !important;">
                            <h6 class="text-white fw-bold mb-3 small text-uppercase border-bottom pb-2" style="border-color: #3c3c3c !important;">
                                <i class="bi bi-gear-fill text-warning me-2"></i> Глобални параметри (Общи настройки)
                            </h6>
                            <div class="row g-3 font-monospace" style="font-size: 0.85rem;">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary mb-1">Вид на главното меню</label>
                                    <select name="LayoutType" id="layoutSelector" class="form-select form-select-sm text-white font-monospace" style="background-color: #333333 !important; border-color: #555555 !important;">
                                        <option value="DASHBOARD">Вертикален страничен контролен панел</option>
                                        <option value="RIBBON">Хоризонтална лента тип MS Excel / Word</option>
                                        <option value="NAVBAR">Хоризонтална лента тип NAVBAR</option>
                                    </select>
                                </div>


                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary mb-1">Режим на уеб темата</label>
                                    <select name="ThemeType" id="themeSelector" class="form-select form-select-sm text-white font-monospace" style="background-color: #333333 !important; border-color: #555555 !important;">
                                        <option value="dark" selected="@(Model.ThemeType == "dark" ? "selected" : null)">Класическа Тъмна Офис Тема (Dark Web)</option>
                                        <option value="light" selected="@(Model.ThemeType == "light" ? "selected" : null)">Класическа Светла Офис Тема (Light Web)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                                             
                        
                    </div>                 

                </div>
            </div>

        </div> <!-- Край на .row -->
    </div> <!-- Край на .container-fluid -->
</form>

<style>
    #vs-tab-system .nav-link {
        color: #aaaaaa !important;
        border-left: 2px solid transparent !important;
        transition: none;
    }

        #vs-tab-system .nav-link.active {
            border-left: 2px solid #007acc !important;
        }

        #vs-tab-system .nav-link:hover:not(.active) {
            background-color: #2d2d2d !important;
            color: #ffffff !important;
        }
</style>
