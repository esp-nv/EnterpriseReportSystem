@model EnterpriseReportSystem.ViewModels.HierarchyCreateViewModel

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-lg border-0 rounded-3 border-start border-success border-4">
        <div class="card-header bg-dark text-white p-3">
            <h4 class="mb-0 fw-bold">✏️ Редакция на Счетоводна Група</h4>
        </div>
        <div class="card-body p-4 bg-light">

            <form asp-action="EditGroup" asp-controller="Setup" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Код на Групата (Непроменяем)</label>
                    <input asp-for="GroupCode" class="form-control bg-white text-muted border-2" readonly="readonly" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Промяна на Главна Категория</label>
                    <select asp-for="SelectedMainTypeCode" asp-items="ViewBag.MainTypes" class="form-select border-2" required="required"></select>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Ново наименование на групата</label>
                    <input asp-for="GroupName" class="form-control border-2 border-success" placeholder="напр. Дребни Преживни, Нова Техника" required="required" />
                    <span asp-validation-for="GroupName" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-lg flex-grow-1 fw-bold shadow-sm">💾 Запази Промените</button>
                    <a asp-action="Hierarchy" class="btn btn-secondary btn-lg fw-bold">❌ Отказ</a>
                </div>
            </form>

        </div>
    </div>
</div>
