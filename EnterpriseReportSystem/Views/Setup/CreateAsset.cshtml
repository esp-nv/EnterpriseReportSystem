@using EnterpriseReportSystem.Common.Constants
@model EnterpriseReportSystem.ViewModels.AssetManualEntryViewModel

@{
    ViewData["Title"] = "Завеждане на нов оперативен актив";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white p-3">
            <h5 class="mb-0 fw-bold"><i class="bi i-plus-circle me-2"></i> Первоначално заприходяване на актив в Холдинга</h5>
        </div>
        <div class="card-body p-4">

            @if (TempData["AssetSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show fw-bold mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["AssetSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="CreateAsset" asp-controller="Setup" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <div class="row">
                    <!-- 1. ИДЕНТИФИКАТОР НА АКТИВА (ЧИСЛО) -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Id" class="form-label small fw-bold">Инвентарен Номер / ID на Актив</label>
                        <input asp-for="Id" type="number" class="form-select" min="1" required
                               placeholder="Въведете числово ID (напр. 1045)">
                        <div class="invalid-feedback">Моля, въведете валидно положително число за Идентификатор.</div>
                    </div>

                    <!-- 2. НАИМЕНОВАНИЕ / СИГНАТУРА НА АКТИВА -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label small fw-bold">Име / Описание на актива</label>
                        <input asp-for="Name" type="text" class="form-control" required
                               maxlength="@ValidationConstants.CompanyNameMaxLength"
                               placeholder="напр. Юница - Херефорд">
                        <div class="invalid-feedback">Името е задължително и не може да надхвърля @ValidationConstants.CompanyNameMaxLength символа.</div>
                    </div>
                </div>

                <div class="row">
                    <!-- 3. ИЗБОР НА ОПЕРАТИВНА ПОДГРУПА ОТ SQL (ЧИСЛОВ КЛЮЧ) -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="SelectedSubGroupCode" class="form-label small fw-bold">Счетоводна Подгрупа (Ниво 3)</label>
                        <select asp-for="SelectedSubGroupCode" asp-items="Model.SubGroupOptions" class="form-select" required>
                            <option value="">-- Изберете оперативна подгрупа --</option>
                        </select>
                        <div class="invalid-feedback">Моля, изберете подгрупа от номенклатурата.</div>
                    </div>

                    <!-- 4. НАЧАЛНО КОЛИЧЕСТВО БРОЙКИ -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="InitialCount" class="form-label small fw-bold">Първоначално заприходено количество</label>
                        <input asp-for="InitialCount" type="number" class="form-control" min="1" required
                               placeholder="Количество бройки">
                        <div class="invalid-feedback">Количеството трябва да бъде минимум 1 бройка.</div>
                    </div>
                </div>

                <hr class="text-muted my-4">
                <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-file-earmark-text me-2"></i> Търговски и Хронологични Индикатори</h6>

                <div class="row">
                    <!-- 5. ДАТА НА ФАКТУРА / ПОКУПКА -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="InvoiceOrPurchaseDate" class="form-label small fw-bold">Дата на покупка / заприходяване</label>
                        <input asp-for="InvoiceOrPurchaseDate" type="date" class="form-control" required>
                        <div class="invalid-feedback">Моля, изберете валидна дата на заприходяване.</div>
                    </div>

                    <!-- 6. ФАКТУРА / ДОКУМЕНТ ОФИЦИАЛНО ОСНОВАНИЕ -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="InvoiceReference" class="form-label small fw-bold">Основание / Документ (Фактура №)</label>
                        <input asp-for="InvoiceReference" type="text" class="form-control" required
                               maxlength="@ValidationConstants.DocumentRefMaxLength"
                               placeholder="напр. Фактура 00010452">
                        <div class="invalid-feedback">Документът е задължителен и не може да надхвърля @ValidationConstants.DocumentRefMaxLength знака.</div>
                    </div>
                </div>

                <!-- 7. ГЕОГРАФСКИ И ЛОКАЦИОННИ ПОЛЕТА (ЗА БЪДЕЩО РАЗШИРЕНИЕ) -->
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Municipality" class="form-label small fw-bold">Община</label>
                        <input asp-for="Municipality" type="text" class="form-control" placeholder="Въведете община">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="TownOrVillage" class="form-label small fw-bold">Населено място</label>
                        <input asp-for="TownOrVillage" type="text" class="form-control" placeholder="Град / Село">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Facility" class="form-label small fw-bold">Физически Обект (Ферма/База)</label>
                        <input asp-for="Facility" type="text" class="form-control" placeholder="Име на ферма">
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-dark btn-lg px-5 fw-bold shadow-sm">
                        <i class="bi bi-save me-2"></i> Заведи Актив в SQL Server
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- СКРИПТ ЗА АКТИВИРАНЕ НА БРАУЗЪРНАТА HTML5 ВАЛИДАЦИЯ НА BOOTSTRAP -->
<script>
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
    })()
</script>
