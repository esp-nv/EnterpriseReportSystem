@using EnterpriseReportSystem.Common.Constants
@model EnterpriseReportSystem.ViewModels.AssetManualEntryViewModel

@{
    ViewData["Title"] = "Завеждане на нов оперативен актив";
}

<div class="container my-5" style="max-width: 900px;">
    <div class="card shadow-sm border border-light-subtle rounded-3">
        <div class="card-header bg-dark text-white p-3 border-0 rounded-top-3 d-flex align-items-center">
            <h5 class="mb-0 fw-bold fs-6 text-uppercase tracking-wider">
                <i class="bi bi-box-seam me-2 text-warning"></i> Първоначално заприходяване на актив
            </h5>
        </div>

        <div class="card-body p-4 bg-light-subtle">

            <form asp-action="CreateAsset" asp-controller="Setup" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <!-- СЕКЦИЯ 1: ИДЕНТИФИКАЦИЯ -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 p-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2 text-uppercase fs-7 text-secondary">
                        <i class="bi bi-info-circle me-2 text-primary"></i> Идентификация и Номенклатура
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Id" class="form-label small fw-bold text-muted">Инвентарен Номер / ID</label>
                            <input asp-for="Id" type="number" class="form-control form-control-sm rounded-2" min="1" required>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label small fw-bold text-muted">Име / Описание на актива</label>
                            <input asp-for="Name" type="text" class="form-control form-control-sm rounded-2" required placeholder="напр. Юница - Херефорд">
                        </div>
                        <div class="col-md-12">
                            <label asp-for="SelectedSubGroupCode" class="form-label small fw-bold text-muted">Счетоводна Подгрупа (Ниво 3)</label>
                            <select asp-for="SelectedSubGroupCode" asp-items="Model.SubGroupOptions" class="form-select form-select-sm rounded-2" required>
                                <option value="">-- Изберете оперативна подгрупа --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- СЕКЦИЯ 2: ФИНАНСОВИ ПОЛЕТА И ТЕГЛО (ТОВА, КОЕТО ЛИПСВАШЕ!) -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 p-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2 text-uppercase fs-7 text-secondary">
                        <i class="bi bi-cash-coin me-2 text-warning"></i> Търговско и Количествено изражение
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="InitialCount" class="form-label small fw-bold text-muted">Количество (Бройки)</label>
                            <input asp-for="InitialCount" type="number" class="form-control form-control-sm rounded-2" min="1" required>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Weight" class="form-label small fw-bold text-muted">Общо Тегло (кг)</label>
                            <input asp-for="Weight" type="number" step="0.01" class="form-control form-control-sm rounded-2" placeholder="напр. 450.50">
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label small fw-bold text-muted">Единична Цена (Доставка)</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control form-control-sm rounded-2" required placeholder="0.00">
                        </div>
                        <div class="col-md-2">
                            <label asp-for="SelectedCurrencyId" class="form-label small fw-bold text-muted">Валута</label>
                            <select asp-for="SelectedCurrencyId" asp-items="Model.CurrencyOptions" class="form-select form-select-sm rounded-2" required>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- СЕКЦИЯ 3: ХРОНОЛОГИЯ И БЕЛЕЖКИ -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 p-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2 text-uppercase fs-7 text-secondary">
                        <i class="bi bi-file-earmark-text me-2 text-success"></i> Документи и Теренни Бележки
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="InvoiceOrPurchaseDate" class="form-label small fw-bold text-muted">Дата на покупка</label>
                            <input asp-for="InvoiceOrPurchaseDate" type="date" class="form-control form-control-sm rounded-2" required>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="InvoiceReference" class="form-label small fw-bold text-muted">Основание (Фактура / Протокол №)</label>
                            <input asp-for="InvoiceReference" type="text" class="form-control form-control-sm rounded-2" required placeholder="напр. Фактура 00010452">
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Notes" class="form-label small fw-bold text-muted">Счетоводни бележки и GPS координати на терена</label>
                            <textarea asp-for="Notes" class="form-control form-control-sm rounded-2" rows="2" maxlength="500" placeholder="Въведете коментар или координати (напр. 42.14, 24.75)"></textarea>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-2 text-end">
                    <button type="submit" class="btn btn-dark btn-md px-5 fw-bold rounded-2 shadow-sm">
                        <i class="bi bi-save me-2 text-warning"></i> Заведи Актив в SQL Server
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
