@using EnterpriseReportSystem.Common.Constants
@model EnterpriseReportSystem.ViewModels.AssetManualEntryViewModel

@{
    ViewData["Title"] = "Завеждане на нов оперативен актив";
}

<div class="container my-5" style="max-width: 900px;">
    <div class="card shadow-sm border border-light-subtle rounded-3">
        <div class="card-header bg-dark text-white p-3 border-0 rounded-top-3">
            <h5 class="mb-0 fw-bold fs-6 text-uppercase">
                <i class="bi bi-box-seam text-warning me-2"></i> Первоначално заприходяване на актив
            </h5>
        </div>

        <form asp-action="CreateAsset" asp-controller="Setup" method="post" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()

            <!-- СКРИТО СЛУЖЕБНО ПОЛЕ: Пренася автоматичното Id скрито от потребителя 
            <input type="hidden" asp-for="Id" value="0" />-->

            <!-- СЕКЦИЯ 1: ИДЕНТИФИКАЦИЯ (ПОПРАВЕНА И ЧИСТА) -->
            <div class="card border-0 shadow-sm rounded-3 mb-4 p-4 bg-white">

                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2 text-uppercase fs-7 text-secondary">
                        <i class="bi bi-info-circle text-primary me-2"></i> Идентификация и Номенклатурна Йерархия
                    </h6>
                    <div class="row g-3">
                        <!-- Свободно текстово поле за Ушна марка -->
                        <div class="col-md-4">
                            <label asp-for="AssetId" class="form-label small fw-bold text-muted">Ушна марка / Инвентарен №</label>
                            <input asp-for="AssetId" type="text" class="form-control form-control-sm rounded-2" required placeholder="напр. BG 123456">
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label small fw-bold text-muted">Име / Спецификация на актива</label>
                            <input asp-for="Name" type="text" class="form-control form-control-sm rounded-2" required placeholder="напр. Юница - Херефорд">
                        </div>

                        <!-- Падащ списък за ДМА / ДНМА / Животни -->
                        <div class="col-md-4">
                            <label asp-for="SelectedMainTypeId" class="form-label small fw-bold text-muted">Категория (ДМА / Животно)</label>
                            <select asp-for="SelectedMainTypeId" asp-items="Model.MainTypeOptions" id="mainTypeSelect" class="form-select form-select-sm rounded-2" required>
                                <option value="">-- Изберете категория --</option>
                            </select>
                        </div>

                        <!-- Взаимосвързан списък: Ниво 2 (Група) -->
                        <div class="col-md-4">
                            <label asp-for="SelectedGroupId" class="form-label small fw-bold text-muted">Счетоводна Група (Ниво 2)</label>
                            <select asp-for="SelectedGroupId" asp-items="Model.GroupOptions" id="groupSelect" class="form-select form-select-sm rounded-2" required>
                                <option value="">-- Изберете група --</option>
                            </select>
                        </div>

                    <!-- Взаимосвързан списък: Ниво 3 (Подгрупа) -->
                    <div class="col-md-6">
                        <label asp-for="SelectedSubGroupId" class="form-label small fw-bold text-muted">Подгрупа (Ниво 3)</label>
                        <select asp-for="SelectedSubGroupId" asp-items="Model.SubGroupOptions" id="subGroupSelect" class="form-select form-select-sm rounded-2" required>
                            <option value="">-- Първо изберете група --</option>
                        </select>
                        <div class="invalid-feedback small">Моля, изберете подгрупа.</div>
                    </div>

                    <!-- НОВОТО ТРЕТО КАСКАДНО МЕНЮ: Порода / Модел (Спецификация) -->
                    <div class="col-md-6">
                        <label asp-for="SelectedSpecificationId" class="form-label small fw-bold text-muted">Спецификация (Порода / Модел)</label>
                        <select asp-for="SelectedSpecificationId" asp-items="Model.SpecificationOptions" id="specificationSelect" class="form-select form-select-sm rounded-2" required>
                            <option value="">-- Първо изберете подгрупа --</option>
                        </select>
                        <div class="invalid-feedback small">Моля, изберете конкретна порода или модел.</div>
                    </div>

                    </div>
                </div>

                <!-- СЕКЦИЯ 2: ФИНАНСИ -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 p-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2 text-uppercase fs-7 text-secondary">
                        <i class="bi bi-cash-coin text-warning me-2"></i> Търговско и Количествено изражение
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="InitialCount" class="form-label small fw-bold text-muted">Количество (Бройки)</label>
                            <input asp-for="InitialCount" type="number" class="form-control form-control-sm rounded-2" min="1" required>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Weight" class="form-label small fw-bold text-muted">Общо Тегло (кг)</label>
                            <input asp-for="Weight" type="number" step="0.01" class="form-control form-control-sm rounded-2" placeholder="0.00">
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label small fw-bold text-muted">Единична Цена</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control form-control-sm rounded-2" required placeholder="0.00">
                        </div>
                        <div class="col-md-2">
                            <label asp-for="SelectedCurrencyId" class="form-label small fw-bold text-muted">Валута</label>
                            <select asp-for="SelectedCurrencyId" asp-items="Model.CurrencyOptions" class="form-select form-select-sm rounded-2" required>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- СЕКЦИЯ 3: ХРОНОЛОГИЯ -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 p-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2 text-uppercase fs-7 text-secondary">
                        <i class="bi bi-file-earmark-text text-success me-2"></i> Документи и Теренни Бележки
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="InvoiceOrPurchaseDate" class="form-label small fw-bold text-muted">Дата на покупка</label>
                            <input asp-for="InvoiceOrPurchaseDate" type="date" class="form-control form-control-sm rounded-2" required>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="InvoiceReference" class="form-label small fw-bold text-muted">Основание (Фактура / Протокол №)</label>
                            <input asp-for="InvoiceReference" type="text" class="form-control form-control-sm rounded-2" required placeholder="напр. Фактура 00010452">
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Notes" class="form-label small fw-bold text-muted">Счетоводни бележки и GPS координати на терена</label>
                            <textarea asp-for="Notes" class="form-control form-control-sm rounded-2" rows="2" maxlength="500" placeholder="Въведете координати или коментар"></textarea>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-2 text-end">
                    <button type="submit" class="btn btn-dark btn-md px-5 fw-bold rounded-2 shadow-sm">
                        <i class="bi bi-save text-warning me-2"></i> Заведи Актив в SQL Server
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JAVASCRIPT ЗА АВТОМАТИЧНО СВЪРЗВАНЕ НА СПИСЪЦИТЕ (КАСКАДЕН ФИЛТЪР) -->
<script>
    // 1. Когато се промени Групата -> Зареждаме Подгрупите
    document.getElementById("groupSelect").addEventListener("change", async function () {
        var groupId = this.value;
        var subGroupSelect = document.getElementById("subGroupSelect");
        var specificationSelect = document.getElementById("specificationSelect");

        subGroupSelect.innerHTML = '<option value="">-- Зареждане... --</option>';
        specificationSelect.innerHTML = '<option value="">-- Първо изберете подгрупа --</option>';

        if (!groupId) {
            subGroupSelect.innerHTML = '<option value="">-- Първо изберете група --</option>';
            return;
        }

        try {
            var response = await fetch('/Setup/GetSubGroupsByGroup?groupId=' + groupId);
            var subGroups = await response.json();

            subGroupSelect.innerHTML = '<option value="">-- Изберете подгрупа --</option>';
            subGroups.forEach(function (item) {
                var option = document.createElement("option");
                option.value = item.id;
                option.text = item.code + " - " + item.name;
                subGroupSelect.appendChild(option);
            });
        } catch (error) {
            subGroupSelect.innerHTML = '<option value="">-- Грешка при зареждане --</option>';
        }
    });

    // 2. ТВОЯТА НОВА ВЕРИГА: Когато се промени Подгрупата -> Зареждаме Породите / Моделите
    document.getElementById("subGroupSelect").addEventListener("change", async function () {
        var subGroupId = this.value;
        var specificationSelect = document.getElementById("specificationSelect");

        specificationSelect.innerHTML = '<option value="">-- Зареждане на породи/модели... --</option>';

        if (!subGroupId) {
            specificationSelect.innerHTML = '<option value="">-- Първо изберете подгрупа --</option>';
            return;
        }

        try {
            var response = await fetch('/Setup/GetSpecificationsBySubGroup?subGroupId=' + subGroupId);
            var specs = await response.json();

            specificationSelect.innerHTML = '<option value="">-- Изберете порода / модел --</option>';
            specs.forEach(function (item) {
                var option = document.createElement("option");
                option.value = item.id;
                option.text = item.name;
                specificationSelect.appendChild(option);
            });
        } catch (error) {
            specificationSelect.innerHTML = '<option value="">-- Грешка при зареждане --</option>';
        }
    });

    // 3. Стандартна Bootstrap валидация
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
    })()
</script>

