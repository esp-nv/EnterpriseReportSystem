@model EnterpriseReportSystem.ViewModels.HierarchyCreateViewModel

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-lg border-0 rounded-3 border-start border-dark border-4">
        <div class="card-header bg-dark text-white p-3">
            <h4 class="mb-0 fw-bold">✏️ Редакция на Оперативна Подгрупа</h4>
        </div>
        <div class="card-body p-4 bg-light">

            <form asp-action="EditSubGroup" asp-controller="Setup" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Код на Подгрупата (Непроменяем)</label>
                    <input asp-for="SubGroupCode" class="form-control bg-white text-muted border-2" readonly="readonly" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Преместване в друга Основна Група</label>
                    <select asp-for="SelectedGroupCode" asp-items="ViewBag.Groups" class="form-select border-2" required="required"></select>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Ново наименование на подгрупата</label>
                    <input asp-for="SubGroupName" class="form-control border-2 border-dark" placeholder="напр. Агнета до 6м, Телета над 12м" required="required" />
                    <span asp-validation-for="SubGroupName" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark text-white btn-lg flex-grow-1 fw-bold shadow-sm">💾 Запази Промените</button>
                    <a asp-action="Hierarchy" class="btn btn-secondary btn-lg fw-bold">❌ Отказ</a>
                </div>
            </form>

        </div>
    </div>
</div>
