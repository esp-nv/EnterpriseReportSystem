@model EnterpriseReportSystem.Models.Entities.Structure.CompanyOrPerson

<div class="container-fluid mt-4 px-4">
    <!-- ГЛАВЕН ХОЛДИНГОВ ПАНЕЛ -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="text-dark fw-bold mb-1">🏢 Мениджър на Корпоративната Структура и Физическите Обекти</h2>
            <p class="text-muted mb-0">Управление на независими фирми, физически лица и оперативни ферми в рамките на холдинга.</p>
        </div>
        <span class="badge bg-success p-2 shadow-sm fs-6">Статус: SQL Server Активен</span>
    </div>

    @if (TempData["HoldingSuccess"] != null)
    {
        <div class="alert alert-success text-center fw-bold shadow-sm border-2 alert-dismissible fade show mb-4" role="alert">
            @TempData["HoldingSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- БУТСТРАП РЕШЕТКА: ВЪВЕЖДАНЕ (ЛЯВО) + СПИЪК (ДЯСНО) -->
    <div class="row g-4">
        
        <!-- ЛЯВ СЕКТОР (35%): КАРТИ ЗА РЪЧНО ВЪВЕЖДАНЕ -->
        <div class="col-xl-4 col-lg-5">
            <div class="sticky-top" style="top: 20px; z-index: 1020;">
                
                <!-- КАРТА 1: СЪЗДАВАНЕ НА СУБЕКТ (ФИРМА ИЛИ ЛИЦЕ) -->
                <div class="card shadow-sm border-0 mb-4 rounded-3 border-start border-primary border-4 bg-white">
                    <div class="card-body p-4">
                        <h6 class="text-primary fw-bold text-uppercase mb-3">Стъпка 1: Добавяне на Юридическо / Физическо Лице</h6>
                        <form asp-action="CreateCompany" asp-controller="Setup" method="post">
                            @Html.AntiForgeryToken()
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Уникален Код на Субекта</label>
                                <input asp-for="ClientCode" class="form-control border-2" placeholder="напр. AGRO_HOLD, IVAN_PETROV" required />
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Наименование / Пълно Име</label>
                                <input asp-for="Name" class="form-control border-2" placeholder="напр. АгроИнвест ЕООД или Иван Иванов" required />
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Данъчен Идентификатор (ЕГН / Булстат)</label>
                                <input asp-for="TaxIdentifier" class="form-control border-2" placeholder="напр. 123456789 или 8010101234" required />
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Административно Седалище (Град / Село)</label>
                                <select asp-for="RegisteredTownId" asp-items="(List<SelectListItem>)ViewData[\"Towns\"]" class="form-select border-2" required>
                                    <option value="">-- Изберете местоположение --</option>
                                </select>
                            </div>
                            
                            <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm py-2">
                                💾 Запиши Независим Субект
                            </button>
                        </form>
                    </div>
                </div>

                <!-- КАРТА 2: СЪЗДАВАНЕ НА ФИЗИЧЕСКИ ОБЕКТ (ФЕРМА / БАЗА / СКЛАД) -->
                <div class="card shadow-sm border-0 mb-4 rounded-3 border-start border-success border-4 bg-white">
                    <div class="card-body p-4">
                        <h6 class="text-success fw-bold text-uppercase mb-3">Стъпка 2: Завеждане на Физически Обект</h6>
                        <form asp-action="CreateFacility" asp-controller="Setup" method="post">
                            @Html.AntiForgeryToken()
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Обвържи със Собственик (Субект)</label>
                                <select name="companyId" class="form-select border-2" required>
                                    <option value="">-- Изберете фирма или лице --</option>
                                    @if (ViewData["Companies"] != null)
                                    {
                                        @foreach (var company in (List<EnterpriseReportSystem.Models.Entities.Structure.CompanyOrPerson>)ViewData["Companies"])
                                        {
                                            <option value="@company.Id">@company.Name (@company.ClientCode)</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold">Код на обекта</label>
                                <input name="facilityCode" class="form-control border-2" placeholder="напр. FERMA_01, SKLAD_V" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold">Име на обекта / Фермата</label>
                                <input name="facilityName" class="form-control border-2" placeholder="напр. Кравеферма Северен сектор" required />
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-5">
                                    <label class="form-label small fw-bold">Пощенски Код</label>
                                    <input name="postalCode" class="form-control border-2" placeholder="напр. 4199" required />
                                </div>
                                <div class="col-md-7">
                                    <label class="form-label small fw-bold">Локация (Град/Село)</label>
                                    <select name="townId" class="form-select border-2" required>
                                        <option value="">-- Изберете --</option>
                                        @if (ViewData["Towns"] != null)
                                        {
                                            @foreach (var town in (List<SelectListItem>)ViewData["Towns"])
                                            {
                                                <option value="@town.Value">@town.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold">Допълнителни Бележки (Notes)</label>
                                <textarea name="notes" class="form-control border-2" rows="2" placeholder="Въведете текущо състояние, капацитет или коментар..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-success w-100 fw-bold shadow-sm py-2">
                                🏭 Заведи Физически Обект + Лог
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </div>

        <!-- ДЕСЕН СЕКТОР (65%): РЕГИСТЪР НА КОРПОРАТИВНИТЕ СУБЕКТИ -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow-sm border-0 rounded-3 bg-white">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark fw-bold">📋 Актуални Фирми и Лица в Холдинговата Структура</h5>
                    <span class="text-muted small">Мулти-фирмен одит и отчетност</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0 bg-white">
                            <thead class="table-dark text-center">
                                <tr>
                                    <th class="py-3">Системен Код</th>
                                    <th class="py-3 text-start">Наименование на субекта</th>
                                    <th class="py-3">ЕГН / Булстат</th>
                                    <th class="py-3">Административен град</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewData["Companies"] != null && ((List<EnterpriseReportSystem.Models.Entities.Structure.CompanyOrPerson>)ViewData["Companies"]).Any())
                                {
                                    @foreach (var company in (List<EnterpriseReportSystem.Models.Entities.Structure.CompanyOrPerson>)ViewData["Companies"])
                                    {
                                        <tr>
                                            <td class="text-center fw-bold text-primary" style="width: 150px;">
                                                <span class="badge bg-light text-primary border border-primary px-3 py-2 fs-6">@company.ClientCode</span>
                                            </td>
                                            <td class="text-start py-3">
                                                                <td class="text-start py-3">
                    <div class="fw-bold text-dark fs-5">@company.Name</div>
                    <small class="text-muted">💼 Данъчен идентификатор: @company.TaxIdentifier</small>
                </td>
                <td class="text-center">
                    <span class="badge bg-secondary px-3 py-2">@company.TaxIdentifier</span>
                </td>
                <td class="text-start">
                    <div class="text-dark">@(company.RegisteredTown?.Name ?? "Няма информация")</div>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="4" class="text-center text-muted p-4 fw-bold">
                📭 Няма намерени заведени субекти в базата данни.
            </td>
        </tr>
    }
</tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
</div>
