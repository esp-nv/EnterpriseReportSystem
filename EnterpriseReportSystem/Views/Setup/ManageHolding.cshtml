@model EnterpriseReportSystem.Models.Entities.Structure.CompanyOrPerson

<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="text-dark fw-bold mb-1">🏢 Мениджър на Структурата</h2>
            <p class="text-muted mb-0">Управление на независими фирми и физически лица.</p>
        </div>
    </div>

    @if (TempData["HoldingSuccess"] != null)
    {
        <div class="alert alert-success text-center fw-bold shadow-sm mb-4">
            @TempData["HoldingSuccess"]
        </div>
    }

    <div class="row g-4">
        <!-- ЛЯВ СЕКТОР (35%): ФОРМИ ЗА ВЪВЕЖДАНЕ -->
        <div class="col-md-4">
            <div class="card p-4 mb-4 shadow-sm bg-white">
                <h6 class="fw-bold text-uppercase mb-3 text-primary">Добавяне на Субект (Фирма / Лице)</h6>
                <form asp-action="CreateCompany" asp-controller="Setup" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Код на Субекта</label>
                        <input asp-for="ClientCode" class="form-control" placeholder="напр. AGRO_HOLD" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Наименование / Име</label>
                        <input asp-for="Name" class="form-control" placeholder="напр. АгроИнвест ЕООД" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">ЕГН / Булстат</label>
                        <input asp-for="TaxIdentifier" class="form-control" placeholder="напр. 123456789" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Административно Седалище (Град / Село)</label>
                        <select asp-for="RegisteredTownId" asp-items="(List<SelectListItem>)ViewData[" Towns"]" class="form-select" required>
                            <option value="">-- Изберете град/село --</option>
                        </select>
                    </div>


                    <button type="submit" class="btn btn-primary w-100 fw-bold">💾 Запиши Субект</button>
                </form>
            </div>
        </div>

        <!-- ДЕСЕН СЕКТОР (65%): СЧЕТОВОДЕН СПИСЪК -->
        <div class="col-md-8">
            <div class="card shadow-sm bg-white">
                <div class="card-header bg-light py-3 border-bottom">
                    <h5 class="mb-0 text-dark fw-bold">📋 Списък на заведените фирми и лица</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0 bg-white">
                            <thead class="table-dark text-center">
                                <tr>
                                    <th class="py-3">Код</th>
                                    <th class="py-3 text-start">Наименование</th>
                                    <th class="py-3">Идентификатор</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewData["Companies"] != null && ((List<EnterpriseReportSystem.Models.Entities.Structure.CompanyOrPerson>)ViewData["Companies"]).Any())
                                {
                                    @foreach (var company in (List<EnterpriseReportSystem.Models.Entities.Structure.CompanyOrPerson>)ViewData["Companies"])
                                    {
                                        <tr>
                                            <td class="text-center fw-bold text-primary">
                                                <span class="badge bg-light text-primary border border-primary p-2">@company.ClientCode</span>
                                            </td>
                                            <td class="text-start py-3 fw-bold text-dark">
                                                @company.Name
                                            </td>
                                            <td class="text-center text-secondary">
                                                @company.TaxIdentifier
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted p-4 fw-bold">📭 Няма намерени субекти в SQL Server.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
